{
  "name": "iel-website",
  "version": "3.0.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "build:vercel": "npm run payload -- migrate && npm run build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "npm run payload -- generate:importmap",
    "generate:types": "npm run payload -- generate:types",
    "migrate:create": "npm run payload -- migrate:create",
    "migrate": "npm run payload -- migrate",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.94.2",
    "@payloadcms/next": "3.94.2",
    "@payloadcms/plugin-cloud-storage": "3.94.2",
    "@payloadcms/richtext-lexical": "3.94.2",
    "@payloadcms/ui": "3.94.2",
    "@supabase/supabase-js": "2.119.2",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "next": "16.4.6",
    "payload": "3.94.2",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.2",
    "dotenv": "16.4.7",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  }
}
