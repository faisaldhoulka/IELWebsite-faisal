# Copy to .env and fill in. Never commit .env.

# CMS Postgres (Payload). Local: `npm run db:up` starts one in Docker.
# Production: the separate CMS project in IEL's Supabase organisation (pooled URL).
DATABASE_URI=postgres://postgres:postgres@127.0.0.1:5433/ielcms
PAYLOAD_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Existing IEL Supabase project: read-only (anon key, server side only).
SUPABASE_URL=https://bfxmfaakufrmzcxhtgfw.supabase.co
SUPABASE_ANON_KEY=

# cms-uploader user: writes to the website-cms bucket only. Leave empty to disable uploads locally.
SUPABASE_CMS_EMAIL=
SUPABASE_CMS_PASSWORD=

# Form relay target (unchanged ielapis API).
CONTACT_API_BASE=https://ielapis.u2ventures.io/api/contact
