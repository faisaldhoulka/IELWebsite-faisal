---
// Shared <head> pieces for pages on the revamp design (advisory-led look).
// Use inside <Fragment slot="head"> on any page that uses SiteHeader/SiteFooter.
// Loads IBM Plex fonts, the Tailwind CDN and the design's colour/font tokens,
// so markup can use classes like `text-pine`, `bg-mist`, `font-serif`.
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Serif:wght@400;500;600&display=swap"
  rel="stylesheet"
/>
<link rel="shortcut icon" href="IEL Assets/partners/favicon.png" type="image/x-icon" />
<script is:inline src="https://cdn.tailwindcss.com"></script>
<script is:inline>
  tailwind.config = {
    theme: {
      extend: {
        // Palette taken from the IEL logo (sampled from Assets/IELTezi-logo-trimmed.webp):
        //   brand green #19A560 · dark green #265140 · light green #59B986
        //   maroon #732E30 · coral #DF4531 · ink #0D1813
        // Text colours are checked for WCAG AA contrast on the backgrounds they sit on;
        // the bright logo green and coral are for shapes/lines, not small text.
        colors: {
          brand: { green: "#19A560", dark: "#265140", light: "#59B986", maroon: "#732E30", coral: "#DF4531" },
          ink: "#0D1813", // body text
          pine: { DEFAULT: "#265140", line: "#3C6A57" }, // logo dark green: dark bands, headings
          accent: { DEFAULT: "#13804A", dark: "#0F6B3E" }, // logo green, deepened for white text: CTAs, links, contact band
          wine: "#732E30", // logo maroon: eyebrows, roles
          signal: { green: "#19A560", red: "#DF4531" }, // logo green / coral: rules and borders
          mint: "#8FD6AE", // light logo green for small text on dark green bands
          mist: "#EFF7F2", // green-tinted light bands
          line: { DEFAULT: "#DCE9E1", strong: "#C6DCCF", soft: "#BFD3C7", dash: "#A6C7B4" },
          muted: { DEFAULT: "#44564D", body: "#37483F" },
          ondark: { DEFAULT: "#C9DDD2", util: "#D9E8DF", soft: "#F1F8F4" },
          placeholder: "#DCEBE2",
        },
        fontFamily: {
          sans: ['"IBM Plex Sans"', "system-ui", "sans-serif"],
          serif: ['"IBM Plex Serif"', "Georgia", "serif"],
        },
        maxWidth: { site: "1200px" },
      },
    },
  };
</script>
<style is:inline>
  html { scroll-behavior: smooth; }
  body { margin: 0; }
  /* Keep in-page jump targets clear of the sticky 72px header. */
  [id] { scroll-margin-top: 88px; }
  /* Desktop dropdown opened by click/keyboard (hover opens it via a Tailwind class). */
  #site-header .dd-panel.dd-open { display: block; }
  /* Mobile menu: hide the native disclosure marker; rotate the + when open. */
  #mobile-nav summary::-webkit-details-marker { display: none; }
  #mobile-nav details[open] > summary span { transform: rotate(45deg); display: inline-block; }

  /* Card grids with 1px dividing lines (use with gap-px + border). Lines are drawn by each
     card, so a row with fewer cards leaves blank space instead of a grey filler block. */
  .grid-lines { background: #FFFFFF; }
  .grid-lines > * { box-shadow: 0 0 0 1px #DCE9E1; }
  .grid-lines-dark { background: #265140; }
  .grid-lines-dark > * { box-shadow: 0 0 0 1px #3C6A57; }

  /* Logo colour stripe (see BrandStripe.astro). */
  .brand-stripe { display: flex; height: 4px; }
  .brand-stripe > span { flex: 1; }

  /* Long-form text (policies, disclosures, articles): wrap content in class="iel-prose". */
  .iel-prose { color: #37483F; font-size: 16px; line-height: 1.7; max-width: 760px; }
  .iel-prose > * + * { margin-top: 1em; }
  .iel-prose h2 { font-family: "IBM Plex Serif", Georgia, serif; font-weight: 500; font-size: 28px; line-height: 1.2; color: #265140; margin-top: 2em; }
  .iel-prose h3 { font-family: "IBM Plex Serif", Georgia, serif; font-weight: 500; font-size: 21px; line-height: 1.3; color: #0D1813; margin-top: 1.6em; }
  .iel-prose h4 { font-weight: 600; font-size: 16px; color: #0D1813; margin-top: 1.4em; }
  .iel-prose h2:first-child, .iel-prose h3:first-child { margin-top: 0; }
  .iel-prose ul, .iel-prose ol { padding-left: 1.4em; }
  .iel-prose ul { list-style: disc; }
  .iel-prose ol { list-style: decimal; }
  .iel-prose li + li { margin-top: 0.4em; }
  .iel-prose li::marker { color: #19A560; }
  .iel-prose a { color: #13804A; text-decoration: underline; }
  .iel-prose a:hover { color: #0F6B3E; }
  .iel-prose strong { color: #0D1813; font-weight: 600; }
  .iel-prose table { width: 100%; border-collapse: collapse; font-size: 15px; }
  .iel-prose th, .iel-prose td { border: 1px solid #DCE9E1; padding: 10px 12px; text-align: left; vertical-align: top; }
  .iel-prose th { background: #EFF7F2; color: #0D1813; font-weight: 600; }
  .iel-prose .table-wrap { overflow-x: auto; }
</style>
