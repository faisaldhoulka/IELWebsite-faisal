---
// "Start a conversation" call-to-action band shown above the footer on inner pages.
// RevampPage adds it automatically; pass noContactBand to RevampPage to hide it.
---
<section class="bg-accent text-white">
  <div class="max-w-site mx-auto px-6 py-14 md:py-16 flex flex-wrap justify-between items-center gap-8">
    <div class="flex flex-col gap-2 max-w-[640px]">
      <h2 class="m-0 font-serif font-medium text-[28px] md:text-[34px] leading-[1.15]">Start a conversation</h2>
      <p class="m-0 text-[16px] text-ondark-soft">Tell us what you are working on. Every enquiry is confidential.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href="index.html#contact" class="bg-white text-accent hover:bg-mist no-underline px-[22px] py-[13px] rounded font-semibold text-[15px]">Discuss a mandate</a>
      <a href="Contact.html" class="border border-white text-white hover:bg-accent-dark no-underline px-[22px] py-[13px] rounded font-semibold text-[15px]">Contact us</a>
    </div>
  </div>
</section>
