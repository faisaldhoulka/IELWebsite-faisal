---
// Inner-page hero in the revamp style (light band, wine eyebrow, serif pine title).
// Optional default slot renders below the lede (e.g. buttons); optional "aside" slot
// fills a right-hand column (e.g. stat tiles, a key-facts box).
//   <PageHero eyebrow="Advisory" title="Financial advisory" lede="..." />
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
import BrandStripe from "./BrandStripe.astro";
const { eyebrow, title, lede } = Astro.props;
const hasAside = Astro.slots.has("aside");
---
<section class="bg-mist border-b border-line">
  <div class:list={[
    "max-w-site mx-auto px-6 pt-14 pb-12 md:pt-20 md:pb-16",
    hasAside && "grid gap-12 items-end [grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr))]",
  ]}>
    <div class="flex flex-col gap-5 max-w-[760px]">
      <BrandStripe class="w-16" />
      {eyebrow && <span class="text-[13px] font-semibold tracking-[1.5px] uppercase text-wine">{eyebrow}</span>}
      <h1 class="m-0 font-serif font-medium text-[36px] md:text-[48px] leading-[1.12] text-pine">{title}</h1>
      {lede && <p class="m-0 text-[17px] md:text-[19px] text-muted-body max-w-[640px]">{lede}</p>}
      {Astro.slots.has("default") && <div class="flex flex-wrap gap-3.5 mt-2"><slot /></div>}
    </div>
    {hasAside && <div><slot name="aside" /></div>}
  </div>
</section>
