---
// Revamp footer: offices plus link columns that reach every page of the site.
import BrandStripe from "./BrandStripe.astro";
const year = new Date().getFullYear();
const columns = [
  {
    title: "Services",
    links: [
      { href: "FinancialAdvisory.html", label: "Financial advisory" },
      { href: "StrategyConsulting.html", label: "Strategy consulting" },
      { href: "RealStateAdvisory.html", label: "Real estate advisory" },
      { href: "BrokerageService.html", label: "Brokerage" },
      { href: "FintechService.html", label: "Fintech and digital" },
    ],
  },
  {
    title: "Insights",
    links: [
      { href: "Research.html", label: "Research" },
      { href: "News.html", label: "News" },
      { href: "Resources.html", label: "Articles" },
      { href: "Investor_education.html", label: "Investor education" },
    ],
  },
  {
    title: "Investors",
    links: [
      { href: "Regulatory.html", label: "Regulatory information" },
      { href: "NewReport.html", label: "Financial statements" },
      { href: "docs/Procedure-for-Complaint-Handling-MUFAP.pdf", label: "Complaints (SECP, PSX)", external: true },
      { href: "Fraud.html", label: "Fraud awareness notice" },
      { href: "RiskDisclosure.html", label: "Risk disclosure" },
    ],
  },
  {
    title: "Company",
    links: [
      { href: "About.html", label: "About IEL" },
      { href: "Contact.html", label: "Contact" },
      { href: "OpenAccount.html", label: "Open an account" },
      { href: "Terms.html", label: "Terms and conditions" },
    ],
  },
];
---
<BrandStripe />
<footer class="bg-pine text-ondark text-sm">
  <div class="max-w-site mx-auto px-6 pt-16 pb-10 grid gap-10 [grid-template-columns:repeat(auto-fit,minmax(min(200px,100%),1fr))]">
    <div class="flex flex-col gap-5">
      <div class="flex flex-col gap-1">
        <span class="font-serif text-2xl text-white font-semibold">IEL</span>
        <span>Integrated Equities Limited</span>
      </div>
      <div class="flex flex-col gap-1">
        <span class="text-white font-semibold">Lahore</span>
        <span>30 Cricketers Colony, 3rd floor, NETSOL Avenue, Ghazi Interchange, Ring Road</span>
      </div>
      <div class="flex flex-col gap-1">
        <span class="text-white font-semibold">Karachi</span>
        <span>Room 134, 3rd floor, KSE Building</span>
      </div>
      <div class="flex flex-col gap-1">
        <a href="tel:+924235741714" class="text-ondark hover:text-white no-underline">+92 42 3574 1714-15</a>
        <a href="mailto:info@iel.net.pk" class="text-ondark hover:text-white no-underline">info@iel.net.pk</a>
      </div>
    </div>
    {columns.map((col) => (
      <nav aria-label={col.title} class="flex flex-col gap-2">
        <span class="text-white font-semibold">{col.title}</span>
        {col.links.map((l) => (
          <a href={l.href} class="text-ondark hover:text-white" {...(l.external ? { target: "_blank", rel: "noopener" } : {})}>{l.label}</a>
        ))}
      </nav>
    ))}
  </div>
  <div class="max-w-site mx-auto px-6 pt-5 pb-10 border-t border-pine-line flex flex-wrap justify-between gap-3 text-[13px]">
    <span>© {year} Integrated Equities Limited. Licensed by SECP. PSX TREC holder.</span>
    <a href="Privacy.html" class="text-ondark hover:text-white">Privacy policy</a>
  </div>
</footer>
