---
// Contact page on the revamp design: contact details + enquiry form, complaints contact,
// and office locations with map tabs. The form posts to the same endpoint and payload as before.
import RevampPage from "../layouts/RevampPage.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";

const details = [
  { label: "Email", value: "support@iel.net.pk", href: "mailto:support@iel.net.pk" },
  { label: "Phone number", value: "+92-42-35741714-15", href: "tel:+924235741714" },
  { label: "Hours", value: "Monday–Friday, 9:00 AM – 6:00 PM (PST)" },
];

const offices = [
  {
    id: "lahore",
    name: "Lahore office",
    address: "30 Cricketers Colony, 3rd floor, NETSOL Avenue, Ghazi Interchange, Ring Road",
    map: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2803.931832327946!2d74.42374977463443!3d31.4986965482142!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39190f4702f9cafb%3A0x8f1d31d128a3ab40!2sGhazi%20Interchange%20Park!5e1!3m2!1sen!2s!4v1751026646944!5m2!1sen!2s",
  },
  {
    id: "karachi",
    name: "Karachi office",
    address: "Room 134, 3rd floor, KSE Building",
    map: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2984.0653418464963!2d66.9982154!3d24.8475401!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3eb315af10b7321f%3A0xa85bfcf37fa6cd63!2sPakistan%20Stock%20Exchange!5e1!3m2!1sen!2s!4v1751034210545!5m2!1sen!2s",
  },
];

const input = "w-full h-[46px] border border-line rounded px-3 text-[15px] text-ink font-sans bg-white aria-[invalid=true]:border-signal-red";
const label = "text-sm font-medium text-ink";
const fieldError = "m-0 text-sm text-signal-red min-h-[1.25em]";
---
<RevampPage
  title="IEL | Contact"
  ogTitle="Contact | Integrated Equities Limited (IEL)"
  description="Smart moves. Sharp insights. Financial freedom—your way. From your first stock pick to your next big acquisition—we're in it with you. IEL brings bespoke brokerage, laser-focused advisory, and strategy consulting under one roof"
  path="Contact.html"
  ogDescription="Get in touch with Integrated Equities Limited (IEL) for any inquiries or assistance you may need."
  noContactBand
>
  <PageHero
    eyebrow="Contact"
    title="Let’s talk about your next smart move"
    lede="Whether you’ve got questions, need guidance, or just want to explore what IEL can do for you — we’re here for it."
  />

  <!-- Details + form -->
  <section class="max-w-site mx-auto px-6 py-16 md:py-24 grid gap-14 [grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr))]">
    <div class="flex flex-col gap-10">
      <div class="flex flex-col gap-3">
        <span class="text-[13px] font-semibold tracking-[1.5px] uppercase text-wine">Get in touch</span>
        <h2 class="m-0 font-serif font-medium text-[30px] md:text-[40px] leading-[1.15] text-pine">Reach out to us</h2>
        <p class="m-0 text-muted-body text-base max-w-[480px]">Have questions or feedback? We are here to help you.</p>
      </div>

      <dl class="m-0 grid gap-px bg-line border border-line">
        {details.map((d) => (
          <div class="bg-white p-5 md:p-6 flex flex-col gap-1">
            <dt class="text-sm text-muted">{d.label}</dt>
            <dd class="m-0 font-serif text-[20px] md:text-[22px] text-pine break-words">
              {d.href ? <a href={d.href} class="text-pine no-underline hover:text-accent hover:underline">{d.value}</a> : d.value}
            </dd>
          </div>
        ))}
      </dl>

      <div class="border border-line border-t-4 border-t-wine p-6 md:p-7 flex flex-col gap-4">
        <h3 class="m-0 font-serif font-medium text-[22px] text-ink">Lodge a complaint</h3>
        <p class="m-0 text-[15px] text-muted-body">
          For any complaint please email us at
          <a href="mailto:compliance@iel.net.pk" class="text-accent hover:text-accent-dark underline">compliance@iel.net.pk</a>.
        </p>
        <div class="flex flex-col gap-1 text-[15px] text-muted-body">
          <span class="text-sm font-semibold text-ink">Contact person for complaints</span>
          <span class="font-semibold text-ink">Mr. Muhammad Iqbal Hussian</span>
          <span class="text-wine font-semibold text-sm">VP / Chief Compliance Officer</span>
          <span>Cell: <a href="tel:+923450091263" class="text-accent hover:text-accent-dark underline">+92 345 0091263</a></span>
          <span>Email: <a href="mailto:compliance@iel.net.pk" class="text-accent hover:text-accent-dark underline">compliance@iel.net.pk</a></span>
        </div>
      </div>
    </div>

    <div class="bg-mist border border-line p-6 md:p-9 self-start">
      <h2 class="m-0 font-serif font-medium text-[26px] text-pine">Send us a message</h2>
      <p class="mt-2 mb-6 text-[15px] text-muted-body">All fields are required.</p>
      <form id="contact-form" class="flex flex-col gap-3" novalidate>
        <div class="flex flex-col gap-1.5">
          <label for="name" class={label}>Name</label>
          <input id="name" name="name" type="text" autocomplete="name" placeholder="e.g. Neha" required aria-describedby="name-error" class={input} />
          <p id="name-error" class={fieldError}></p>
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="email" class={label}>Email address</label>
          <input id="email" name="email" type="email" autocomplete="email" placeholder="e.g. neha@gmail.com" required aria-describedby="email-error" class={input} />
          <p id="email-error" class={fieldError}></p>
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="subject" class={label}>Subject</label>
          <input id="subject" name="subject" type="text" placeholder="e.g. Finance" required aria-describedby="subject-error" class={input} />
          <p id="subject-error" class={fieldError}></p>
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="comments" class={label}>Comments</label>
          <textarea id="comments" name="comments" rows="6" placeholder="e.g. Hi, I want to get information…" required aria-describedby="comments-error" class="w-full border border-line rounded p-3 text-[15px] text-ink font-sans bg-white aria-[invalid=true]:border-signal-red"></textarea>
          <p id="comments-error" class={fieldError}></p>
        </div>
        <button id="submit-btn" type="submit" class="bg-accent hover:bg-accent-dark text-white border-0 px-[22px] py-[13px] rounded font-semibold text-[15px] font-sans cursor-pointer disabled:opacity-60">Submit</button>
        <div role="status" aria-live="polite" class="min-h-[1.5em]">
          <p id="success-message" class="m-0 text-[15px] text-accent font-semibold"></p>
          <p id="error-submit" class="m-0 text-[15px] text-signal-red"></p>
        </div>
      </form>
    </div>
  </section>

  <!-- Offices -->
  <section class="bg-mist border-t border-line">
    <div class="max-w-site mx-auto px-6 py-16 md:py-24">
      <SectionHeading eyebrow="Locations" title="Our offices" />
      <div class="grid gap-px grid-lines border border-line [grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr))] md:[grid-template-columns:minmax(260px,1fr)_2fr]">
        <div role="tablist" aria-label="Office locations" class="bg-white flex flex-col">
          {offices.map((o, i) => (
            <button
              type="button"
              role="tab"
              id={`${o.id}-tab`}
              data-tab={o.id}
              aria-controls={`${o.id}-map`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              class="text-left bg-white hover:bg-mist aria-selected:bg-mist border-0 border-b border-line border-l-4 border-l-transparent aria-selected:border-l-accent p-6 font-sans cursor-pointer flex flex-col gap-1.5"
            >
              <span class="font-serif text-[20px] text-pine">{o.name}</span>
              <span class="text-sm text-muted-body">{o.address}</span>
            </button>
          ))}
        </div>
        <div class="bg-white">
          {offices.map((o, i) => (
            <div id={`${o.id}-map`} role="tabpanel" aria-labelledby={`${o.id}-tab`} class="map-content h-[320px] md:h-[400px]" hidden={i !== 0}>
              <iframe
                src={o.map}
                title={`Map of the IEL ${o.name}`}
                class="w-full h-full block border-0"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <script is:inline slot="scripts">
    (function () {
      const form = document.getElementById("contact-form");
      const formInputs = {
        name: document.getElementById("name"),
        email: document.getElementById("email"),
        subject: document.getElementById("subject"),
        comments: document.getElementById("comments"),
      };
      const submitBtn = document.getElementById("submit-btn");
      const successMessage = document.getElementById("success-message");
      const errorSubmit = document.getElementById("error-submit");

      function setError(key, message) {
        const input = formInputs[key];
        const errorEl = document.getElementById(key + "-error");
        if (message) {
          input.setAttribute("aria-invalid", "true");
          errorEl.textContent = message;
        } else {
          input.removeAttribute("aria-invalid");
          errorEl.textContent = "";
        }
      }

      // Same rules as before: all four fields required, email must match \S+@\S+\.\S+
      function validateForm() {
        const errors = {};
        if (!formInputs.name.value.trim()) errors.name = "Name is required";
        if (!formInputs.email.value.trim()) errors.email = "Email is required";
        else if (!/\S+@\S+\.\S+/.test(formInputs.email.value)) errors.email = "Valid email is required";
        if (!formInputs.subject.value.trim()) errors.subject = "Subject is required";
        if (!formInputs.comments.value.trim()) errors.comments = "Comments are required";
        Object.keys(formInputs).forEach((key) => setError(key, errors[key]));
        return errors;
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const errors = validateForm();
        const firstInvalid = Object.keys(errors)[0];
        if (firstInvalid) {
          formInputs[firstInvalid].focus();
          return;
        }

        const formData = {
          name: formInputs.name.value,
          email: formInputs.email.value,
          subject: formInputs.subject.value,
          comments: formInputs.comments.value,
        };

        submitBtn.disabled = true;
        successMessage.textContent = "";
        errorSubmit.textContent = "Sending…";
        try {
          const response = await fetch("https://ielapis.u2ventures.io/api/contact/contactus/", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(formData),
          });
          if (!response.ok) throw new Error("Failed to submit form");

          errorSubmit.textContent = "";
          successMessage.textContent = "Thank you. Your message has been sent.";
          form.reset();
          setTimeout(() => (successMessage.textContent = ""), 20000);
        } catch (error) {
          successMessage.textContent = "";
          errorSubmit.textContent = "Failed to submit form. Please try again, or email support@iel.net.pk.";
          console.error("Error submitting form:", error);
        } finally {
          submitBtn.disabled = false;
        }
      });

      // Clear a field's error when the user edits it
      Object.keys(formInputs).forEach((key) => {
        formInputs[key].addEventListener("input", () => setError(key, ""));
      });

      // Office map tabs
      const tabs = Array.from(document.querySelectorAll('[role="tab"][data-tab]'));
      function switchTab(tab) {
        tabs.forEach((btn) => {
          const selected = btn.dataset.tab === tab;
          btn.setAttribute("aria-selected", selected ? "true" : "false");
          btn.tabIndex = selected ? 0 : -1;
          document.getElementById(btn.dataset.tab + "-map").hidden = !selected;
        });
      }
      tabs.forEach((btn, i) => {
        btn.addEventListener("click", () => switchTab(btn.dataset.tab));
        btn.addEventListener("keydown", (e) => {
          if (e.key !== "ArrowDown" && e.key !== "ArrowUp" && e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
          e.preventDefault();
          const step = e.key === "ArrowDown" || e.key === "ArrowRight" ? 1 : -1;
          const next = tabs[(i + step + tabs.length) % tabs.length];
          switchTab(next.dataset.tab);
          next.focus();
        });
      });
    })();
  </script>
</RevampPage>
