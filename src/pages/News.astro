---
// News: announcements load from Supabase in the browser (public/supabaseNews.js).
import RevampPage from "../layouts/RevampPage.astro";
import PageHero from "../components/PageHero.astro";
---
<RevampPage
  title="IEL | News"
  ogTitle="News | Integrated Equities Limited (IEL)"
  description="Smart moves. Sharp insights. Financial freedom—your way.
From your first stock pick to your next big acquisition—we're in it with you. IEL brings bespoke brokerage, laser-focused advisory, and strategy consulting under one roof"
  path="News.html"
  ogDescription="Stay updated with the latest news, market developments, and announcements from IEL."
>
  <PageHero
    eyebrow="Newsroom"
    title="News"
    lede="Announcements, public notices and offer documents from Integrated Equities Limited."
  />

  <section class="max-w-site mx-auto px-6 py-16 md:py-24" aria-labelledby="news-heading">
    <div class="flex flex-col gap-3 mb-10">
      <span class="text-[13px] font-semibold tracking-[1.5px] uppercase text-wine">Announcements</span>
      <h2 id="news-heading" class="m-0 font-serif font-medium text-[30px] md:text-[40px] leading-[1.15] text-pine">Latest news</h2>
    </div>

    <div id="dynamic-news" aria-live="polite">
      <p class="m-0 border border-line bg-mist p-6 text-[15px] text-muted-body">Loading news…</p>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script is:inline src="supabaseNews.js?v=2"></script>
  </Fragment>
</RevampPage>
