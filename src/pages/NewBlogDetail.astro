---
// Article detail: NewBlogDetail.html?id=<blog id>. The article loads from Supabase in the
// browser (inline script below); the list lives on Resources.html.
import RevampPage from "../layouts/RevampPage.astro";
---
<RevampPage
  title="IEL | Article"
  description="Smart moves. Sharp insights. Financial freedom—your way. From your first stock pick to your next big acquisition—we're in it with you. IEL brings bespoke brokerage, laser-focused advisory, and strategy consulting under one roof"
  path="NewBlogDetail.html"
>
  <Fragment slot="head">
    <style is:inline>
      /* Images and embeds inside the rich-text article body */
      #blog-body img { max-width: 100%; height: auto; margin: 2rem 0; }
      #blog-body iframe, #blog-body video { max-width: 100%; }
      #blog-body em { font-style: italic; }
    </style>
  </Fragment>

  <!-- Article header -->
  <section class="bg-mist border-b border-line">
    <div class="max-w-site mx-auto px-6 pt-14 pb-12 md:pt-20 md:pb-16 flex flex-col gap-5">
      <a href="Resources.html" class="self-start font-semibold text-[15px] text-accent hover:text-accent-dark underline">← All articles</a>
      <span id="blog-meta" class="text-[13px] font-semibold tracking-[1.5px] uppercase text-wine">Article</span>
      <h1 id="blog-title" class="m-0 max-w-[860px] font-serif font-medium text-[32px] md:text-[44px] leading-[1.15] text-pine">Loading article…</h1>
    </div>
  </section>

  <!-- Article body (dynamic) -->
  <section class="max-w-site mx-auto px-6 py-16 md:py-24">
    <div class="max-w-[760px]">
      <div id="loading" class="border border-line bg-mist p-6 text-[15px] text-muted-body" role="status">
        Loading article…
      </div>

      <div id="error" class="hidden border border-line border-l-4 border-l-signal-red p-6 flex flex-col gap-3" role="alert">
        <p class="m-0 text-[15px] text-ink">This article could not be found or failed to load.</p>
        <a href="Resources.html" class="self-start bg-accent hover:bg-accent-dark text-white no-underline px-[22px] py-[13px] rounded font-semibold text-[15px]">Back to articles</a>
      </div>

      <article id="blog-detail" class="hidden">
        <img id="blog-hero" class="hidden w-full max-h-[440px] object-cover border border-line mb-10" alt="" />
        <div id="blog-body" class="iel-prose">
          <!-- Dynamic content loaded here -->
        </div>
        <div class="mt-12 pt-6 border-t border-line">
          <a href="Resources.html" class="font-semibold text-[15px] text-accent hover:text-accent-dark underline">← All articles</a>
        </div>
      </article>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script is:inline>
      const supabaseUrl = "https://bfxmfaakufrmzcxhtgfw.supabase.co";
      const supabaseKey =
        "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJmeG1mYWFrdWZybXpjeGh0Z2Z3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTk4MTQzMTIsImV4cCI6MjA3NTM5MDMxMn0.qtNn0qXNhn8ol8fTSb2Hp9nQkYfFA2Y_Zec4LuISPZQ";

      let supabaseClient = null;

      function initSupabase() {
        if (typeof supabase === "undefined") {
          console.warn("supabase global not ready yet, waiting...");
          setTimeout(initSupabase, 100);
          return;
        }

        const { createClient } = supabase;
        supabaseClient = createClient(supabaseUrl, supabaseKey);
        console.log("Supabase client initialized!", supabaseClient);

        // Load the article once the client exists
        loadBlogDetail();
      }

      const urlParams = new URLSearchParams(window.location.search);
      const blogId = urlParams.get("id");

      function showError() {
        document.getElementById("loading").classList.add("hidden");
        document.getElementById("error").classList.remove("hidden");
        document.getElementById("blog-title").textContent = "Article not found";
      }

      async function loadBlogDetail() {
        if (!blogId) {
          showError();
          return;
        }

        const loading = document.getElementById("loading");
        const detail = document.getElementById("blog-detail");

        try {
          const { data: blog, error } = await supabaseClient
            .from("blogs")
            .select("title, img, desc, created_at")
            .eq("id", blogId)
            .single();

          if (error || !blog) throw error;

          // Hero image (hidden when missing or broken)
          const heroImg = document.getElementById("blog-hero");
          if (blog.img) {
            heroImg.src = blog.img;
            heroImg.alt = blog.title || "Article image";
            heroImg.onerror = () => heroImg.classList.add("hidden");
            heroImg.classList.remove("hidden");
          }

          // Title
          document.getElementById("blog-title").textContent = blog.title || "Untitled";

          // Body (supports HTML from rich text editor)
          document.getElementById("blog-body").innerHTML = blog.desc || "<p>No content available.</p>";

          // Date in the meta line: "Article · 22 November 2025"
          if (blog.created_at) {
            const date = new Date(blog.created_at);
            if (!isNaN(date)) {
              document.getElementById("blog-meta").textContent =
                "Article · " +
                date.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
            }
          }

          loading.classList.add("hidden");
          detail.classList.remove("hidden");

          document.title = `IEL | ${blog.title || "Article"}`;
        } catch (err) {
          console.error(err);
          showError();
        }
      }

      initSupabase();
    </script>
  </Fragment>
</RevampPage>
