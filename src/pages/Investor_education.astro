---
// Investor Education — revamp design. Downloadable guides, trading terms and regulations.
import RevampPage from "../layouts/RevampPage.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";

const dir = "IEL Assets/PDF/Investor Education/";
const doc = (name: string) => ({ name, href: `${dir}${name}.pdf` });

const groups = [
  {
    id: "guides",
    title: "Investor guides",
    docs: [
      doc("Investor Guide SECP English"),
      doc("Investor Guide Urdu"),
      doc("PSX Invester Awareness Guide Book - Urdu"),
      doc("Trading Common Terms in English"),
      doc("Common Terms Urdu"),
    ],
  },
  {
    id: "trading",
    title: "Trading with IEL",
    docs: [
      doc("Internet Trading Terms"),
      doc("Order Executions Flow"),
      doc("Service Level Agreement"),
      doc("Risk Disclosure"),
      doc("User Manual Soct Tech"),
    ],
  },
  {
    id: "regulations",
    title: "Regulations and policies",
    docs: [
      doc("Arbitration Regulations English"),
      doc("Arbitration Regulations Urdu"),
      doc("PSX-Regulations-October-03-2025-Bonus-and-Right-Issue-Timelines"),
      doc("Annexure B1 - IEL AMLCFTCPF Policy Approved on 22 March 2024"),
    ],
  },
];
const total = groups.reduce((n, g) => n + g.docs.length, 0);
---
<RevampPage
  title="IEL | Investor Education"
  ogTitle="Investor Education | Integrated Equities Limited (IEL)"
  description="Smart moves. Sharp insights. Financial freedom—your way. From your first stock pick to your next big acquisition—we're in it with you. IEL brings bespoke brokerage, laser-focused advisory, and strategy consulting under one roof"
  path="Investor_education.html"
  ogDescription="Investor education resources from IEL: guides, risk disclosures, trading terms, and regulatory documents to help you invest with confidence."
>
  <PageHero
    eyebrow="Investors"
    title="Investor Education"
    lede="Investor education resources from IEL: guides, risk disclosures, trading terms, and regulatory documents to help you invest with confidence."
  >
    {groups.map((g, i) => (
      <a
        href={`#${g.id}`}
        class={i === 0
          ? "bg-accent hover:bg-accent-dark text-white no-underline px-[22px] py-[13px] rounded font-semibold text-[15px]"
          : "border border-ink text-ink hover:bg-white no-underline px-[22px] py-[13px] rounded font-semibold text-[15px]"}
      >{g.title}</a>
    ))}
  </PageHero>

  <section class="max-w-site mx-auto px-6 py-16 md:py-24">
    <SectionHeading
      eyebrow="Downloads"
      title="Investor Education"
      intro={`${total} documents, each opens as a PDF in a new tab.`}
    />
    <div class="flex flex-col gap-14">
      {groups.map((g) => (
        <div id={g.id} class="scroll-mt-24">
          <h3 class="m-0 mb-5 font-serif font-medium text-[24px] md:text-[28px] text-pine">{g.title}</h3>
          <ul class="list-none m-0 p-0 grid gap-px bg-line border border-line">
            {g.docs.map((d) => (
              <li class="bg-white hover:bg-mist">
                <a
                  href={d.href}
                  target="_blank"
                  rel="noopener"
                  class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 md:px-7 py-5 no-underline text-ink"
                >
                  <span class="text-[16px] md:text-[17px] font-medium [overflow-wrap:anywhere] min-w-0">{d.name}</span>
                  <span class="text-sm font-semibold text-accent hover:text-accent-dark underline shrink-0">Download PDF</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</RevampPage>
