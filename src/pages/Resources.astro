---
// Resources: downloadable account forms plus the latest articles, which load from
// Supabase in the browser (public/supabaseBlogs.js) and link to NewBlogDetail.html?id=...
import RevampPage from "../layouts/RevampPage.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";

const forms = [
  { title: "Corporate New", text: "Account opening form for companies and other corporate clients.", href: "IEL Assets/PDF/Corporate_new.pdf" },
  { title: "Individual New", text: "Account opening form for individual investors.", href: "IEL Assets/PDF/Individual_new.pdf" },
  { title: "Commission Slab", text: "IEL brokerage commission schedule.", href: "IEL Assets/PDF/IEL_Commission_Schedule.pdf" },
  { title: "10 FATCA", text: "FATCA self-certification form.", href: "IEL Assets/PDF/10_FATCA.pdf" },
  { title: "CRS Form", text: "Common Reporting Standard self-certification form.", href: "IEL Assets/PDF/CRS_Form.pdf" },
  { title: "For US Citizen", text: "Additional form for US citizens and US persons.", href: "IEL Assets/PDF/For_US_Citizen.pdf" },
];
---
<RevampPage
  title="IEL | Resources"
  ogTitle="Resources | Integrated Equities Limited (IEL)"
  description="Smart moves. Sharp insights. Financial freedom—your way.
From your first stock pick to your next big acquisition—we're in it with you. IEL brings bespoke brokerage, laser-focused advisory, and strategy consulting under one roof"
  path="Resources.html"
  ogDescription="Access IEL's resources covering sector analysis, market insights, and investment intelligence for Pakistan's capital markets."
>
  <PageHero
    eyebrow="Resources"
    title="Resources"
    lede="Your investment toolkit, simplified. From account forms to market articles, find what you need when you need it."
  />

  <!-- Related forms (Resources.html#related_forms is linked from the footer) -->
  <section id="related_forms" class="max-w-site mx-auto px-6 py-16 md:py-24 scroll-mt-24">
    <SectionHeading
      eyebrow="Downloads"
      title="Related forms"
      intro="Forms for opening and maintaining an account with IEL, as PDF."
    />
    <ul class="list-none m-0 p-0 grid gap-px grid-lines border border-line [grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr))]">
      {forms.map((f) => (
        <li class="bg-white p-7 flex flex-col gap-2.5">
          <span class="text-[13px] text-wine font-semibold">PDF form</span>
          <h3 class="m-0 font-serif font-normal text-[22px] leading-[1.3]">{f.title}</h3>
          <p class="m-0 text-[15px] text-muted-body">{f.text}</p>
          <a
            href={f.href}
            download
            target="_blank"
            class="mt-3 self-start font-semibold text-[15px] text-accent hover:text-accent-dark underline"
          >Download <span class="sr-only">{f.title} </span>PDF →</a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Latest articles (loaded by supabaseBlogs.js) -->
  <section class="bg-mist border-y border-line">
    <div class="max-w-site mx-auto px-6 py-16 md:py-24">
      <SectionHeading eyebrow="Articles" title="Our latest articles" />
      <div id="loading" class="border border-line bg-white p-6 text-[15px] text-muted-body" role="status">Loading articles…</div>
      <div
        id="blog-container"
        class="grid gap-6 [grid-template-columns:repeat(auto-fill,minmax(min(300px,100%),1fr))]"
        aria-live="polite"
      ></div>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script is:inline src="supabaseBlogs.js?v=2"></script>
  </Fragment>
</RevampPage>
