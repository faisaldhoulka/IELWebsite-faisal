---
// Homepage — revamp design "IEL Advisory Website Revamp" (advisory-led).
// Bracketed text such as [Client name] or [XX] marks content still to be supplied.
import RevampPage from "../layouts/RevampPage.astro";

const stats = [
  { value: "2008", label: "Advising and executing since" },
  { value: "A- / A-2", label: "VIS entity rating, long and short term" },
  { value: "[XX]", label: "Transactions advised" },
  { value: "PKR [XX] bn", label: "Capital raised and transacted" },
];

const services = [
  { title: "Equity capital markets", text: "IPO readiness, main board and GEM board listings, rights issues, offers for sale and private placements.", cta: "Discuss a listing" },
  { title: "Debt and sukuk", text: "Sukuk and TFC structuring, Shariah-compliant financing, loan syndication and debt arrangement.", cta: "Discuss a raise" },
  { title: "Mergers and acquisitions", text: "Buy-side and sell-side advisory, joint ventures, due diligence coordination and transaction agreements.", cta: "Discuss a deal" },
  { title: "Valuation and feasibility", text: "Financial models, independent valuations, feasibility studies and investor presentations.", cta: "Request a valuation" },
  { title: "Restructuring", text: "Financial and corporate restructuring, lender negotiations and balance sheet repair.", cta: "Talk to us" },
  { title: "Strategy consulting", text: "Business plans, strategy reviews, market entry and real estate project advisory.", cta: "Talk to us" },
];

const transactions = [
  { tag: "[Year] · Equity capital markets", client: "[Client name]", desc: "Initial public offering, PSX main board", size: "PKR [X] bn", role: "[Lead advisor / Arranger]" },
  { tag: "[Year] · Debt and sukuk", client: "[Client name]", desc: "Privately placed sukuk", size: "PKR [X] bn", role: "[Lead advisor / Arranger]" },
  { tag: "[Year] · Mergers and acquisitions", client: "[Client name]", desc: "Sell-side advisory on stake sale", size: "PKR [X] bn", role: "[Financial advisor]" },
  { tag: "[Year] · Block execution", client: "[Client name]", desc: "Block trade through IEL brokerage", size: "[X] m shares", role: "[Executing broker]" },
];

const stages = [
  { name: "Assess", color: "border-signal-green", text: "We review the business, the numbers and the options, and tell you plainly whether the transaction makes sense." },
  { name: "Structure", color: "border-wine", text: "Valuation, instrument design, regulatory route with SECP and PSX, and the information memorandum." },
  { name: "Market", color: "border-signal-red", text: "Investor and counterparty outreach, roadshows, book building and negotiation of terms." },
  { name: "Close", color: "border-pine", text: "Documentation, approvals, settlement and execution through our brokerage where shares change hands." },
];

const team = [
  { role: "Chief Executive Officer", bio: "[Two lines on deal experience: sectors, notable mandates, prior firms.]" },
  { role: "Head of Advisory", bio: "[Two lines on deal experience: sectors, notable mandates, prior firms.]" },
  { role: "Head of Research", bio: "[Two lines on coverage and experience.]" },
];

const insights = [
  { tag: "Sector note · [Date]", title: "[Sector deep dive title, e.g. fertilizer sector outlook]", text: "Peer comparison, earnings drivers and valuation." },
  { tag: "Morning Insights · Daily", title: "Pre-open note on PSX, rates and commodities", text: "Index levels, headlines and the day's outlook." },
  { tag: "Market Closing · Daily", title: "End-of-day PSX wrap", text: "Gainers, laggers, volume leaders and sector participation." },
];

const associates = [
  { src: "IEL Assets/company_2.png", alt: "PACRA" },
  { src: "IEL Assets/company_3.png", alt: "TASDEEQ" },
  { src: null, alt: "[Logo]" },
  { src: null, alt: "[Logo]" },
];

const eyebrow = "text-[13px] font-semibold tracking-[1.5px] uppercase text-wine";
const h2 = "m-0 font-serif font-medium text-[32px] md:text-[40px] leading-[1.15] text-pine";
---
<RevampPage
  title="IEL | Financial and Transaction Advisory in Pakistan"
  ogTitle="Integrated Equities Limited (IEL)"
  description="Integrated Equities Limited (IEL) advises companies, sponsors and investors on IPOs, debt and sukuk, mergers and acquisitions, and fundraising, with its own PSX brokerage for execution."
  path="index.html"
  noContactBand
>
    <!-- Hero -->
    <section id="top" class="bg-mist border-b border-line">
      <div class="max-w-site mx-auto px-6 pt-16 pb-14 md:pt-24 md:pb-[88px] grid gap-14 items-end [grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr))]">
        <div class="flex flex-col gap-6">
          <span class={eyebrow}>Financial and transaction advisory · Lahore and Karachi</span>
          <h1 class="m-0 font-serif font-medium text-[40px] md:text-[56px] leading-[1.1] text-pine">
            Advice on listings, capital raising and corporate transactions in Pakistan.
          </h1>
          <p class="m-0 text-[17px] md:text-[19px] text-muted-body max-w-[600px]">
            IEL advises companies, sponsors and investors on IPOs, debt and sukuk, mergers and acquisitions, and fundraising. Our own PSX brokerage executes what we structure.
          </p>
          <div class="flex flex-wrap gap-3.5 mt-2">
            <a href="#contact" class="bg-accent hover:bg-accent-dark text-white no-underline px-[26px] py-[15px] rounded font-semibold text-base">Discuss a mandate</a>
            <a href="#transactions" class="border border-ink text-ink hover:bg-white no-underline px-[25px] py-[14px] rounded font-semibold text-base">View transactions</a>
          </div>
        </div>
        <dl class="m-0 grid grid-cols-2 gap-px bg-line-strong border border-line-strong border-t-4 border-t-signal-red">
          {stats.map((s) => (
            <div class="bg-white p-5 md:p-7 flex flex-col-reverse">
              <dt class="text-sm text-muted">{s.label}</dt>
              <dd class="m-0 font-serif text-[28px] md:text-[36px] text-pine">{s.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Advisory services -->
    <section id="advisory" class="max-w-site mx-auto px-6 py-16 md:py-24">
      <div class="flex flex-wrap justify-between items-end gap-6 mb-12">
        <div class="flex flex-col gap-3 max-w-[640px]">
          <span class={eyebrow}>Advisory services</span>
          <h2 class={h2}>One team from first model to closing.</h2>
        </div>
        <p class="m-0 max-w-[420px] text-muted-body text-base">
          Each mandate is led by a partner and staffed by analysts who build the model, draft the documents and sit in the negotiations.
        </p>
      </div>
      <div class="grid gap-px grid-lines border border-line [grid-template-columns:repeat(auto-fit,minmax(min(340px,100%),1fr))]">
        {services.map((s, i) => (
          <a href="#contact" data-mandate={s.title} class="group bg-white hover:bg-mist p-7 md:p-9 no-underline text-ink flex flex-col gap-3.5">
            <span class="text-[13px] text-wine font-semibold">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="m-0 font-serif font-medium text-2xl">{s.title}</h3>
            <p class="m-0 text-muted-body text-[15px]">{s.text}</p>
            <span class="text-sm font-semibold text-accent group-hover:underline">{s.cta} →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Transactions -->
    <section id="transactions" class="bg-pine text-white">
      <div class="max-w-site mx-auto px-6 py-16 md:py-24">
        <div class="flex flex-wrap justify-between items-end gap-6 mb-12">
          <div class="flex flex-col gap-3">
            <span class="text-[13px] font-semibold tracking-[1.5px] uppercase text-signal-green">Selected transactions</span>
            <h2 class="m-0 font-serif font-medium text-[32px] md:text-[40px] leading-[1.15]">Recent mandates</h2>
          </div>
          <a href="#transactions" class="text-white font-semibold text-[15px] underline">All transactions →</a>
        </div>
        <div class="grid gap-5 [grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr))]">
          {transactions.map((t) => (
            <article class="border border-pine-line p-7 flex flex-col gap-2.5">
              <span class="text-[13px] text-signal-green font-semibold">{t.tag}</span>
              <h3 class="m-0 font-serif font-normal text-[22px]">{t.client}</h3>
              <span class="text-[15px] text-ondark">{t.desc}</span>
              <span class="font-serif text-[28px] mt-2">{t.size}</span>
              <span class="text-[13px] text-ondark border-t border-pine-line pt-3">IEL role: {t.role}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- How a mandate runs -->
    <section class="max-w-site mx-auto px-6 py-16 md:py-24">
      <div class="flex flex-col gap-3 mb-12 max-w-[640px]">
        <span class={eyebrow}>How a mandate runs</span>
        <h2 class={h2}>Four stages, one accountable partner.</h2>
      </div>
      <ol class="list-none m-0 p-0 grid gap-8 [grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr))]">
        {stages.map((s) => (
          <li class={`border-t-4 ${s.color} pt-5 flex flex-col gap-2`}>
            <h3 class="m-0 font-serif font-normal text-[22px]">{s.name}</h3>
            <p class="m-0 text-muted-body text-[15px]">{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Team -->
    <section id="team" class="bg-mist border-y border-line">
      <div class="max-w-site mx-auto px-6 py-16 md:py-24">
        <div class="flex flex-wrap justify-between items-end gap-6 mb-12">
          <div class="flex flex-col gap-3">
            <span class={eyebrow}>Leadership</span>
            <h2 class={h2}>The people who lead your mandate</h2>
          </div>
          <a href="About.html" class="font-semibold text-[15px] text-accent hover:text-accent-dark underline">Full team →</a>
        </div>
        <div class="grid gap-6 [grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr))]">
          {team.map((m) => (
            <article class="bg-white border border-line flex flex-col">
              <div class="h-60 bg-placeholder flex items-center justify-center text-muted text-sm">[Portrait]</div>
              <div class="p-6 flex flex-col gap-1.5">
                <h3 class="m-0 font-serif font-normal text-[22px]">[Name]</h3>
                <span class="text-sm text-wine font-semibold">{m.role}</span>
                <p class="mt-1.5 mb-0 text-sm text-muted-body">{m.bio}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Insights -->
    <section id="insights" class="max-w-site mx-auto px-6 py-16 md:py-24">
      <div class="flex flex-wrap justify-between items-end gap-6 mb-12">
        <div class="flex flex-col gap-3 max-w-[640px]">
          <span class={eyebrow}>Insights</span>
          <h2 class={h2}>Research that informs our advice</h2>
        </div>
        <a href="Research.html" class="font-semibold text-[15px] text-accent hover:text-accent-dark underline">All insights →</a>
      </div>
      <div class="grid gap-6 [grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr))]">
        {insights.map((n) => (
          <a href="Research.html" class="no-underline text-ink border border-line hover:border-line-dash hover:bg-mist p-7 flex flex-col gap-2.5">
            <span class="text-[13px] text-wine font-semibold">{n.tag}</span>
            <span class="font-serif text-[22px] leading-[1.3]">{n.title}</span>
            <span class="text-sm text-muted-body">{n.text}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Brokerage band -->
    <section id="brokerage" class="border-y border-line bg-mist">
      <div class="max-w-site mx-auto px-6 py-12 flex flex-wrap justify-between items-center gap-6">
        <div class="flex flex-col gap-1.5 max-w-[640px]">
          <h2 class="m-0 font-serif font-normal text-[26px] text-pine">Trading with IEL</h2>
          <p class="m-0 text-[15px] text-muted-body">
            Our PSX brokerage, rated BFR 2 by VIS, serves individual, corporate and institutional investors. Open an account online in minutes.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="OpenAccount.html" class="border border-ink text-ink hover:bg-white no-underline px-[22px] py-[13px] rounded font-semibold text-[15px]">Open an account</a>
          <a href="BrokerageService.html" class="border border-ink text-ink hover:bg-white no-underline px-[22px] py-[13px] rounded font-semibold text-[15px]">Brokerage services</a>
        </div>
      </div>
    </section>

    <!-- Associated companies -->
    <section id="about" class="max-w-site mx-auto px-6 py-[72px] flex flex-col gap-7">
      <h2 class={`m-0 ${eyebrow}`}>Associated companies</h2>
      <ul class="list-none m-0 p-0 grid gap-5 [grid-template-columns:repeat(auto-fit,minmax(min(200px,100%),1fr))]">
        {associates.map((c) =>
          c.src ? (
            <li class="h-[88px] border border-line flex items-center justify-center">
              <a href="About.html#Associated_Company" class="flex items-center justify-center h-full w-full">
                <img src={c.src} alt={c.alt} class="max-h-12 w-auto" loading="lazy" />
              </a>
            </li>
          ) : (
            <li class="h-[88px] border border-dashed border-line-dash flex items-center justify-center text-muted text-sm">{c.alt}</li>
          )
        )}
      </ul>
    </section>

    <!-- Contact -->
    <section id="contact" class="bg-accent text-white">
      <div class="max-w-site mx-auto px-6 py-16 md:py-24 grid gap-14 [grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr))]">
        <div class="flex flex-col gap-4">
          <h2 class="m-0 font-serif font-medium text-[32px] md:text-[40px] leading-[1.15]">Start a conversation</h2>
          <p class="m-0 text-[17px] text-ondark-soft">
            Tell us what you are working on. A partner replies within [one business day], and every enquiry is confidential.
          </p>
          <div class="mt-4 flex flex-col gap-1.5 text-[15px] text-ondark-soft">
            <a href="tel:+924235741714" class="text-ondark-soft no-underline hover:text-white">+92 42 3574 1714-15</a>
            <a href="mailto:info@iel.net.pk" class="text-ondark-soft no-underline hover:text-white">info@iel.net.pk</a>
          </div>
        </div>
        <form id="mandate-form" class="grid grid-cols-1 sm:grid-cols-2 gap-4" novalidate>
          <label class="flex flex-col gap-1.5 text-sm font-medium">Name
            <input name="name" type="text" required autocomplete="name" class="h-[46px] border-0 rounded px-3 text-[15px] text-ink font-sans" />
          </label>
          <label class="flex flex-col gap-1.5 text-sm font-medium">Company
            <input name="company" type="text" autocomplete="organization" class="h-[46px] border-0 rounded px-3 text-[15px] text-ink font-sans" />
          </label>
          <label class="flex flex-col gap-1.5 text-sm font-medium">Email
            <input name="email" type="email" required autocomplete="email" class="h-[46px] border-0 rounded px-3 text-[15px] text-ink font-sans" />
          </label>
          <label class="flex flex-col gap-1.5 text-sm font-medium">Type of mandate
            <select name="mandate" class="h-[46px] border-0 rounded px-3 text-[15px] text-ink font-sans bg-white">
              {services.map((s) => <option>{s.title}</option>)}
            </select>
          </label>
          <label class="flex flex-col gap-1.5 text-sm font-medium sm:col-span-2">Brief description
            <textarea name="description" rows="4" required class="border-0 rounded p-3 text-[15px] text-ink font-sans"></textarea>
          </label>
          <button type="submit" class="sm:col-span-2 h-[50px] border-0 rounded bg-wine hover:brightness-110 text-white text-base font-semibold font-sans cursor-pointer disabled:opacity-60">Send enquiry</button>
          <p id="mandate-status" class="sm:col-span-2 m-0 text-[15px] min-h-[1.5em]" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  <script is:inline slot="scripts">
    // Service cards preselect the mandate type in the contact form.
    document.querySelectorAll("[data-mandate]").forEach((card) => {
      card.addEventListener("click", () => {
        const select = document.querySelector('#mandate-form select[name="mandate"]');
        if (select) select.value = card.dataset.mandate;
      });
    });

    // Contact form: posts to the same endpoint as Contact.html (name, email, subject, comments).
    const form = document.getElementById("mandate-form");
    const statusEl = document.getElementById("mandate-status");
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const d = Object.fromEntries(new FormData(form));
      const payload = {
        name: d.name.trim(),
        email: d.email.trim(),
        subject: "Mandate enquiry: " + d.mandate + (d.company ? " (" + d.company.trim() + ")" : ""),
        comments: (d.company ? "Company: " + d.company.trim() + "\n" : "") + "Mandate: " + d.mandate + "\n\n" + d.description.trim(),
      };
      const button = form.querySelector('button[type="submit"]');
      button.disabled = true;
      statusEl.textContent = "Sending…";
      try {
        const res = await fetch("https://ielapis.u2ventures.io/api/contact/contactus/", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error("HTTP " + res.status);
        form.reset();
        statusEl.textContent = "Thank you. Your enquiry has been sent.";
      } catch (err) {
        console.error("Enquiry failed:", err);
        statusEl.textContent = "Sorry, the enquiry could not be sent. Please email info@iel.net.pk.";
      } finally {
        button.disabled = false;
      }
    });
  </script>
</RevampPage>
