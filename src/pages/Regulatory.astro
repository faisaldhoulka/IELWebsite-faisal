---
import RevampPage from "../layouts/RevampPage.astro";
import PageHero from "../components/PageHero.astro";

const description = `Smart moves. Sharp insights. Financial freedom—your way.
From your first stock pick to your next big acquisition—we're in it with you. IEL brings bespoke brokerage, laser-focused advisory, and strategy consulting under one roof`;

// Registration details (previously shown only inside the "Regulatory_new_img.png" graphic).
const registration = [
  { label: "Status of the company", value: "Public Limited, Unlisted" },
  { label: "Company Registration Number", value: "006729" },
  { label: "Broker Registration Number", value: "BRL-159" },
  { label: "TRE Certificate Number", value: "293" },
  { label: "National Tax Number", value: "3151684-0" },
  { label: "PRA Punjab", value: "P-3151685-0" },
];

const toc = [
  { id: "registration", label: "Registration details" },
  { id: "governance", label: "Board and governance" },
  { id: "advisors", label: "Auditors, advisors and bankers" },
  { id: "offices", label: "Offices" },
  { id: "status-ratings", label: "Status, ratings and shareholding" },
];

const th = "w-[38%] sm:w-[260px] font-semibold";
---
<RevampPage
  title="IEL | Regulatory Information"
  description={description}
  path="Regulatory.html"
  ogDescription="Corporate governance, board composition, regulatory status, and shareholding information for Integrated Equities Limited (IEL)."
  ogTitle="Regulatory Information | Integrated Equities Limited (IEL)"
>
  <PageHero
    eyebrow="Corporate information"
    title="Regulatory Information"
    lede="Corporate governance, board composition, regulatory status, and shareholding information for Integrated Equities Limited (IEL)."
  />

  <section class="max-w-site mx-auto px-6 py-16 md:py-24">
    <div class="grid gap-12 lg:grid-cols-[240px_minmax(0,1fr)]">
      <aside class="lg:sticky lg:top-8 self-start">
        <nav aria-label="On this page">
          <p class="m-0 mb-3 text-[13px] font-semibold tracking-[1.5px] uppercase text-wine">On this page</p>
          <ul class="m-0 p-0 list-none flex flex-col gap-2">
            {toc.map((t) => (
              <li><a href={`#${t.id}`} class="text-[15px] text-muted-body hover:text-pine no-underline">{t.label}</a></li>
            ))}
          </ul>
        </nav>
      </aside>

      <div class="min-w-0">
        <h2 id="registration" class="m-0 font-serif font-medium text-[28px] leading-[1.2] text-pine">Registration details</h2>
        <dl class="mt-6 mb-0 grid gap-px grid-lines border border-line [grid-template-columns:repeat(auto-fit,minmax(min(220px,100%),1fr))]">
          {registration.map((r) => (
            <div class="bg-white p-6 flex flex-col gap-2">
              <dt class="text-[13px] font-semibold tracking-[1px] uppercase text-muted">{r.label}</dt>
              <dd class="m-0 font-serif font-medium text-[24px] leading-[1.2] text-pine">{r.value}</dd>
            </div>
          ))}
        </dl>

        <div class="iel-prose mt-16">
          <h2 id="governance">Board and governance</h2>
          <div class="overflow-x-auto">
            <table>
              <tbody>
                <tr>
                  <th scope="row" class={th}>Board of Directors</th>
                  <td>
                    Mr. Sardar Ali Wattoo — Chief Executive Officer <br />
                    Mrs. Sadia Ali — Director <br />
                    Syed Kashan Hussain Kazmi — Executive Director / Chief Operating Officer <br />
                    Mr. Muhammad Iqbal Hussain — Executive Director / Chief Compliance Officer <br />
                    Mr. Muhammad Mohsin Nawaz Sabri – Independent Director <br />
                    Mr. Bashir Ahmed Sheikh – Independent Director <br />
                    Sed Akbar Naqi Zaidi – Non-Executive Director
                  </td>
                </tr>
                <tr>
                  <th scope="row" class={th}>Chairman</th>
                  <td>Mr. Bashir Ahmed Sheikh – Independent Director</td>
                </tr>
                <tr>
                  <th scope="row" class={th}>Chief Financial Officer</th>
                  <td>Mr. Muhammad Bilal</td>
                </tr>
                <tr>
                  <th scope="row" class={th}>Company Secretary</th>
                  <td>Mr. Sardar Ali Wattoo</td>
                </tr>
                <tr>
                  <th scope="row" class={th}>Audit Committee</th>
                  <td>
                    Mr. Muhammad Mohsin Nawaz Sabri, Chairman <br />
                    Mrs. Sadia Ali, Member <br />
                    Mr. Syed Akbar Naqi Zaidi, Member
                  </td>
                </tr>
                <tr>
                  <th scope="row" class={th}>HR &amp; Remuneration Committee</th>
                  <td>
                    Mr. Bashir Ahmed Sheikh, Chairman <br />
                    Mr. Sardar Ali, Member <br />
                    Mrs. Sadia Ali, Member
                  </td>
                </tr>
                <tr>
                  <th scope="row" class={th}>Head of Internal Audit</th>
                  <td>Mr. Muhammad Shahjahan</td>
                </tr>
                <tr>
                  <th scope="row" class={th}>Compliance and Risk Committee</th>
                  <td>
                    Mr. Muhammad Mohsin Nawaz Sabri, Chairman <br />
                    Mrs. Sadia Ali, Member <br />
                    Mr. Syed Akbar Naqi Zaidi, Member
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <h2 id="advisors">Auditors, advisors and bankers</h2>
          <div class="overflow-x-auto">
            <table>
              <tbody>
                <tr>
                  <th scope="row" class={th}>Statutory Auditors</th>
                  <td>
                    BDO Ebrahim &amp; Co., Chartered Accountants <br />
                    Office No. 4, 6th Floor, Askari Corporate Tower, 75/76 D-1, Main
                    Boulevard Gulberg-III, Lahore <br />
                    <strong>Tel: +92 42 3587 5707-10</strong> <br />
                    <strong>Email: <a href="mailto:info@bdo.com.pk">info@bdo.com.pk</a></strong>
                  </td>
                </tr>
                <tr>
                  <th scope="row" class={th}>Legal Advisors</th>
                  <td>Imran Anujm Alvi Associates, Advocate Supreme Court Lahore</td>
                </tr>
                <tr>
                  <th scope="row" class={th}>Bankers</th>
                  <td>
                    Bank Al Habib Limited, Allied Bank Limited, Meezan Bank Limited,
                    Sindh Bank Limited, JS Bank Limited, Samba Bank Limited, Bank
                    Alfalah Limited, Bank Makramah Limited
                  </td>
                </tr>
                <tr>
                  <th scope="row" class={th}>Share Registrar</th>
                  <td>COPRLINK (Pvt) Ltd., Wings Arcade, 1-K, Commercial, Model Town, Lahore</td>
                </tr>
              </tbody>
            </table>
          </div>

          <h2 id="offices">Offices</h2>
          <div class="overflow-x-auto">
            <table>
              <tbody>
                <tr>
                  <th scope="row" class={th}>Registered Office</th>
                  <td>
                    30 Cricketers Colony, 3rd Floor, NETSOL Avenue, Ghazi
                    Interchange, Ring Road, Lahore, Pakistan <br />
                    <strong>
                      Tel: +92 42 3574 1714-15 · Email: <a href="mailto:info@iel.net.pk">info@iel.net.pk</a> · Web:
                      <a href="https://www.iel.net.pk">www.iel.net.pk</a>
                    </strong>
                  </td>
                </tr>
                <tr>
                  <th scope="row" class={th}>Karachi Office</th>
                  <td>
                    Room 134, 3rd Floor, KSE Building, Stock Exchange Road, Karachi <br />
                    <strong>Tel: +92 42 3569 2606 · <a href="https://www.iel.net.pk">www.iel.net.pk</a></strong>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <h2 id="status-ratings">Status, ratings and shareholding</h2>
          <div class="overflow-x-auto">
            <table>
              <tbody>
                <tr>
                  <th scope="row" class={th}>Regulatory Status</th>
                  <td>
                    Public limited (unlisted) company — incorporated July 01, 2008 <br />
                    TREC Holder, Pakistan Stock Exchange Limited (Trading and
                    Self-Clearing category)
                  </td>
                </tr>
                <tr>
                  <th scope="row" class={th}>Credit Rating</th>
                  <td>
                    Entity: A- (long term) / A-2 (short term) — VIS Credit Rating
                    Company Limited <br />
                    Broker Fiduciary Rating: BFR-2
                  </td>
                </tr>
                <tr>
                  <th scope="row" class={th}>Subsidiary</th>
                  <td>Gulab Online (Private) Limited — 74% shareholding</td>
                </tr>
                <tr>
                  <th scope="row" class={th}>Digital Platform</th>
                  <td>
                    Tezi — digital investing platform ·
                    <a href="https://tezi.com.pk" target="_blank" rel="noopener">tezi.com.pk</a>
                  </td>
                </tr>
                <tr>
                  <th scope="row" class={th}>Shareholding Pattern</th>
                  <td>
                    <a
                      href="IEL Assets/PDF/PATTERN OF SHAREHOLDING AS ON JUNE 30, 2026.pdf"
                      target="_blank"
                      rel="noopener"
                    >Pattern of Shareholding as on June 30, 2026</a> (PDF)
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>
</RevampPage>
