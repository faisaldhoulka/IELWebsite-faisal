---
// About — revamp design. Company profile, mission, board, key management, associated companies.
import RevampPage from "../layouts/RevampPage.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";

const about = [
  "Integrated Equities Limited (IEL) is a Pakistan-based financial services firm providing investment banking, corporate finance advisory, equity brokerage and investment research services to corporations, sponsors and investors.",
  "Our advisory practice supports clients throughout the transaction lifecycle—from evaluating strategic alternatives and developing financial models to valuation, transaction structuring, capital raising, investor engagement and execution. Our experience spans public and private equity transactions, mergers and acquisitions, strategic partnerships, joint ventures, corporate restructuring, project finance and capital-market offerings.",
  "IEL combines rigorous financial analysis with a practical understanding of Pakistan’s business, regulatory and capital-market environment. We work closely with management teams, boards, shareholders and professional advisers across sectors including energy and infrastructure, power and utilities, industrials, consumer businesses, textiles, food, technology and real estate.",
  "Our approach is analytical, commercially focused and execution-driven. We aim to provide clear, independent and decision-useful advice—helping clients understand opportunities, manage risks and structure transactions that support sustainable long-term value.",
];

const mission = [
  { title: "We cut through the confusion", text: "straight talk about money, zero intimidation" },
  { title: "Every big investor started with one rupee", text: "your first step matters more than your bank balance" },
  { title: "Ask us anything", text: "Seriously, we've heard every question and we're here for it" },
  { title: "When you grow, Pakistan grows", text: "your success fuels the economy we're all building together" },
  { title: "Learn first, earn smart", text: "confidence comes from understanding, not guessing" },
  { title: "Pakistan's financial future runs through you", text: "We're building wealth for the generation that's building Pakistan" },
];

// Bios are word for word from the previous About page.
const board = [
  { name: "Sardar Ali Wattoo", role: "Sponsor / Director / CEO", img: "IEL Assets/Members/sardar_ali_watto.png",
    bio: "Above 28 years experience. Served top management positions in renowned business houses/groups. Vast experience of finance, equity & debt IPO/listings; Mills finance syndications, M&A, Real Estate, Energy, Telecom, IT, Media, Financial Services, Textiles, Cement, Pipelines, Pharma and Projects development." },
  { name: "Sadia Ali", role: "Sponsor / Non-Executive Director", img: "IEL Assets/Members/Sadia_ali.png",
    bio: "Sadia graduated from Punjab University in 1994 and served as Director & CEO of Poseidon Synergies (Private) Limited from 2008 to 2015. Poseidon is currently the parent company of Singer Pakistan Limited. Sadia is a shareholder of Integrated Equities Limited and has continuously served on its board since 2008." },
  { name: "Syed Kashan Hussain Kazmi", role: "Director / COO", img: "IEL Assets/Members/kashan_hussan.png",
    bio: "Kashan Kazmi is a senior finance and management professional with over 25 years of working experience in Financial Industry of Pakistan in different roles in Capital Markets, Asset Management and Investment Advisory, Portfolio Management, and Equity Brokerage. He has previously served as CEO of First Capital Investments Limited (FCIL)." },
  { name: "Muhammad Mohsin Nawaz Sabri", role: "Independent Director", img: "IEL Assets/Members/mohsin.jpeg",
    bio: "Mr. Muhammad Mohsin Nawaz Sabri is an advocate Hight Court and a member of Punjab Bar Council. He has done his Post Graduate Diploma in International Affairs and LL.B. from Punjab University in 2016 and has been practicing law since then. He is Ex Vice Chairman of Human Rights Committee High Court and is legal advisor to various companies and has high ambitions about his future." },
  { name: "Muhammad Iqbal Hussain", role: "Director/CCO", img: "IEL Assets/Members/iqbal_hussain.png",
    bio: "A seasoned professional with over 20 years of experience in Regulatory Compliance, Risk Management, Finance, and Corporate Advisory across diverse industries in Pakistan and abroad. His expertise includes Corporate Restructuring, IPOs, Mergers & Acquisitions, PSX listings, and regulatory matters. He brings strong leadership, governance, and strategic management capabilities, with extensive experience in leading crossfunctional teams and supporting business growth." },
  { name: "Syed Akbar Naqi Zaidi", role: "Non-Executive Director", img: "IEL Assets/Members/akbar_naqi.png",
    bio: "Akbar Naqi is a senior management professional with over 20 years of experience across Brokerage, Corporate Finance, Telecom, and Media. He has worked on transactions exceeding US$300 million at First Capital Group, including mergers, listings, and the first foreign-listed convertible bond by a Pakistani company. He also contributed to Sindh Bank’s acquisition of a full commercial banking license. He previously served as Executive Director at AlHoqani Securities and is currently the CEO of Media Info Systems." },
  { name: "Bashir Ahmed Sheikh", role: "Independent Director", img: "IEL Assets/Members/bashir_ahmad.jpeg",
    bio: "A seasoned banking professional with over 56 years of diverse domestic and international experience across Corporate, Commercial and Retail Banking, Investment and Risk Management. He has held senior management positions in leading financial institutions, with extensive expertise in Syndications, Equity Investments, Underwriting, Advisory Services, Mergers & Acquisitions, Privatization, Compliance and Regulatory Affairs. He has also served on the Boards of First Capital Corporation, Dawood Leasing, Japan Power Generation, Al Hamra Hills and Al Hamra Avenue." },
];

const management = [
  { name: "Sardar Ali Wattoo", role: "Chief Executive Officer", img: "IEL Assets/Members/sardar_ali_watto.png",
    bio: "Above 28 years experience. Served top management positions in renowned business houses/groups. Vast experience of finance, equity & debt IPO/listings; Mills finance syndications, M&A, Real Estate, Energy, Telecom, IT, Media, Financial Services, Textiles, Cement, Pipelines, Pharma and Projects development." },
  { name: "Kashan Kazmi", role: "Chief Operating Officer", img: "IEL Assets/Members/kashan_hussan.png",
    bio: "Highly focused, results oriented senior level finance and management professional with extensive hands-on diverse experience in Treasury, Financial Accounting, Asset Management, Mills & Procurement Administration and Business leadership. Has over 25 years of experience in various industries" },
  { name: "Haroon Khalil", role: "Head of Investment Banking", img: "IEL Assets/Members/haroon_khalil.jpeg",
    bio: "He is a seasoned professional with over 10 years of diverse experience in finance, accounts, and regulatory compliance. His expertise includes corporate restructuring, mergers and acquisitions, and listing of companies on PSX. Haroon is an ACCA and a graduate of OBU, with an MBA from LUMS." },
  { name: "Saniya Tauseef", role: "Head of Research", img: "IEL Assets/Members/sania_touseef.jpeg",
    bio: "She has 12+ years’ experience across PACRA, Digicom and A.F. Ferguson, with research, ratings, audit and credit-risk exposure. Finance and research professional with 12+ years’ experience across auditing, accounting, financial management, credit risk assessment and economic research, including senior research and ratingsroles at PACRA." },
  { name: "Muhammad Iqbal Hussain", role: "Head of Compliance", img: "IEL Assets/Members/iqbal_hussain.png",
    bio: "Seasoned professional with a rich diverse experience spanning over 20 years. He is MBA (Finance), PIPFA qualified and having PMR and FCM certifications of IFMP. He also have AML/CFT Training for Directors and Compliance Managers conducted by SECP (IFMP)." },
  { name: "Muhammad Shahjahan", role: "Head of Internal Audit", img: "IEL Assets/Members/shahahan.jpeg",
    bio: "A Chartered Management Accountant with around seven years of experience in Internal Audit, Financial Reporting and Advisory, with expertise in Risk Management, Internal Controls, Compliance and Financial Analysis. He has contributed to strengthening governance, improving business processes and addressing operational and financial risks." },
  { name: "Bilal Hanif", role: "Chief Financial Officer", img: "IEL Assets/Members/bilal_hanif.png",
    bio: "Bilal is a commerce graduate and completed his Article-ship from Nasir Javaid Maqsood Imran Chartered Accountants. He has over 10 years of experience in accounting, audit, financial reporting and taxation." },
  { name: "Asif Hussain", role: "Manager Equities", img: "IEL Assets/Members/asif_hussan.jpeg",
    bio: "He is graduate and has PMR, FCM and SBC certifications of IFMP. Highly experience manager with more than 15 years of capital market experience. He has a deep understanding of the stock’s technical analysis and has good communication with the Client’s to execute trades based on their Investment Portfolio Statements." },
  { name: "Faisal Khan", role: "Manager Operations", img: "IEL Assets/Members/faisal_khan.jpeg",
    bio: "Faisal is a graduate and has more than 15 years of experience in Operations, IT and settlements. He has obtained AML/CFT Training for Directors and Compliance Managers conducted by SECP (IFMP)." },
  { name: "Waseem Ul Hassan", role: "General Manager Accounts", img: "IEL Assets/Members/waseem_ul_hassan.jpeg",
    bio: "Waseem is a seasoned finance professional with over 27 years of experience in accounting and finance. He is a graduate and has completed his CA Articles. He has 20 years of experience in the brokerage industry." },
  { name: "Sabir Bashir", role: "AVP Corporate Finance", img: "IEL Assets/Members/sabir_bashir.jpeg",
    bio: "Sabir is a Chartered Accountant (Finalist) and completed his Article-ship from Nasir Javaid Maqsood Imran Chartered Accountants. Having more than 4 years of experience in liaising with the Company & Audit Firm to assist in Audit and Assurance, Financial Accounting, Corporate and Finance Management related activities." },
  { name: "Waleed Zafar", role: "Financial Analyst", img: "IEL Assets/Members/waleed-zafar-new-pic.jpeg",
    bio: "Waleed, a CFA Level III candidate, holds a BBA from the University of Central Punjab and brings close to two years of experience as a Financial Analyst. He has expertise in financial modelling, valuations, pitchdeck preparation, and comprehensive industry research." },
  { name: "Muhammad Adil", role: "Financial Analyst", img: "IEL Assets/Members/muhammad_adil.jpeg",
    bio: "Adil is a member of ICMAP and a CFA Level II candidate, bringing nearly two years of experience as a Financial Analyst in addition to one year in accounting. His background includes detailed financial modelling, industry research, pitch-deck, and valuations." },
  { name: "Shahzaib Shafiq", role: "Research Analyst", img: "IEL Assets/Members/shahzaib_shafiq.jpeg",
    bio: "Shahzaib Shafiq is a CA Finalist with over 4 years of professional experience in the fields of audit of financial statements and tax return/advisory services. He has completed his article ship from KPMG Taseer Hadi & Co." },
];

const associates = [
  {
    name: "PACRA",
    logo: "IEL Assets/company_2.png",
    text: "Pakistan's first and leading credit rating agency since 1994, established with Fitch Ratings and IFC. With 8,500+ rating opinions across 55+ sectors and complete independence, PACRA covers 40% of KSE-100 companies.",
  },
  {
    name: "TASDEEQ",
    logo: "IEL Assets/company_3.png",
    text: "Pakistan's first State Bank licensed credit information bureau. Enabling smarter lending decisions that catalyses credit market growth.",
  },
];

const groups = [
  { id: "board", title: "Board of Directors", people: board },
  { id: "management", title: "Key Management", people: management },
];
---
<RevampPage
  title="IEL | About Us"
  ogTitle="About Us | Integrated Equities Limited (IEL)"
  description="Smart moves. Sharp insights. Financial freedom—your way. From your first stock pick to your next big acquisition—we're in it with you. IEL brings bespoke brokerage, laser-focused advisory, and strategy consulting under one roof"
  path="About.html"
  ogDescription="Pakistan-based financial services firm offering brokerage, corporate advisory, and investment research. Meet the team behind IEL."
>
  <PageHero
    eyebrow="About IEL"
    title="About Us"
    lede="The difference between hoping and knowing? Having IEL in your corner."
  >
    <a href="#team" class="bg-accent hover:bg-accent-dark text-white no-underline px-[22px] py-[13px] rounded font-semibold text-[15px]">Meet the team</a>
    <a href="#Associated_Company" class="border border-ink text-ink hover:bg-white no-underline px-[22px] py-[13px] rounded font-semibold text-[15px]">Associated companies</a>
  </PageHero>

  <!-- About -->
  <section id="about" class="max-w-site mx-auto px-6 py-16 md:py-24 grid gap-10 md:gap-16 [grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr))]">
    <div class="flex flex-col gap-3">
      <span class="text-[13px] font-semibold tracking-[1.5px] uppercase text-wine">Who we are</span>
      <h2 class="m-0 font-serif font-medium text-[30px] md:text-[40px] leading-[1.15] text-pine">About</h2>
    </div>
    <div class="iel-prose">
      {about.map((p) => <p class="m-0">{p}</p>)}
    </div>
  </section>

  <!-- Mission -->
  <section id="mission" class="bg-pine text-white">
    <div class="max-w-site mx-auto px-6 py-16 md:py-24">
      <SectionHeading
        dark
        eyebrow="What drives us"
        title="Our Mission"
        intro="We look after Pakistan's next generation of investors—because your first investment should feel empowering, not intimidating."
      />
      <ul class="list-none m-0 p-0 grid gap-px grid-lines-dark border border-pine-line [grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr))]">
        {mission.map((m, i) => (
          <li class="bg-pine p-7 md:p-8 flex flex-col gap-2.5">
            <span class="text-[13px] text-signal-green font-semibold">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="m-0 font-serif font-normal text-[22px] leading-[1.3]">{m.title}</h3>
            <p class="m-0 text-[15px] text-ondark">{m.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Team -->
  <section id="team" class="bg-mist border-b border-line">
    <div class="max-w-site mx-auto px-6 py-16 md:py-24">
      <SectionHeading
        eyebrow="Leadership"
        title="Meet the Team"
        intro="A team of varied experiences, driven by the same belief: wealth building isn't just for the wealthy."
      />
      <nav aria-label="Team sections" class="flex flex-wrap gap-3 mb-12">
        {groups.map((g) => (
          <a href={`#${g.id}`} class="border border-ink text-ink hover:bg-white no-underline px-[22px] py-[13px] rounded font-semibold text-[15px]">{g.title}</a>
        ))}
      </nav>
      {groups.map((g, gi) => (
        <div id={g.id} class:list={["scroll-mt-24", gi > 0 && "mt-16 md:mt-20"]}>
          <h3 class="m-0 mb-8 pb-4 border-b border-line-strong font-serif font-medium text-[26px] md:text-[30px] text-pine">{g.title}</h3>
          <div class="grid gap-6 [grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr))]">
            {g.people.map((p) => (
              <article class="bg-white border border-line flex flex-col">
                <img src={p.img} alt={p.name} class="w-full h-72 object-cover object-top bg-placeholder" loading="lazy" />
                <div class="p-6 flex flex-col gap-1.5">
                  <h4 class="m-0 font-serif font-normal text-[22px] leading-[1.25] text-ink">{p.name}</h4>
                  <span class="text-sm text-wine font-semibold">{p.role}</span>
                  <details class="group mt-3 border-t border-line pt-3">
                    <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden text-sm font-semibold text-accent hover:text-accent-dark">
                      <span class="group-open:hidden">Read bio +</span>
                      <span class="hidden group-open:inline">Hide bio −</span>
                    </summary>
                    <p class="mt-3 mb-0 text-sm text-muted-body leading-[1.6]">{p.bio}</p>
                  </details>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Associated companies (linked from the homepage as About.html#Associated_Company) -->
  <section id="Associated_Company" class="max-w-site mx-auto px-6 py-16 md:py-24 scroll-mt-24">
    <SectionHeading eyebrow="Associated companies" title="Associated and Affiliate Companies" />
    <div class="grid gap-px grid-lines border border-line [grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr))]">
      {associates.map((c) => (
        <article class="bg-white p-7 md:p-9 flex flex-col gap-4">
          <div class="h-[72px] flex items-center">
            <img src={c.logo} alt={`${c.name} logo`} class="max-h-12 w-auto" loading="lazy" />
          </div>
          <h3 class="m-0 font-serif font-medium text-2xl text-pine">{c.name}</h3>
          <p class="m-0 text-[15px] text-muted-body">{c.text}</p>
        </article>
      ))}
    </div>
  </section>
</RevampPage>
