---
// Open Account page on the revamp design: hero with quick sign-up form, brokerage rates,
// account types (Sahulat / Individual / Corporate) with steps and FAQs.
// The sign-up form posts to the same endpoint and payload as before ({ phone, name }).
import RevampPage from "../layouts/RevampPage.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";

const CDC_PORTAL_URL =
  "https://cgp.cdcaccess.com.pk/cdc/cgp/r/centralized-gateway-portal/login?intermediary=N3NMZGYHUKU46";

const rates = [
  { value: "0.03 Paisas", label: "brokerage for shares under PKR 10", text: "Ultra-low flat-rate trading costs so your profits stay yours." },
  { value: "0.05 Paisas", label: "brokerage for shares between PKR 10–30", text: "Still among the lowest in the market — designed for active traders." },
  { value: "0.15%", label: "brokerage for shares above PKR 30", text: "Transparent, minimal fees that keep more money in your portfolio." },
  { value: "PKR 0.01", label: "daily rollover for shares up to PKR 75", text: "Hold positions overnight without breaking the bank." },
  { value: "PKR 0.05", label: "maximum daily rollover, even for premium shares", text: "No hidden charges. No surprises. Just honest costs that let your investments grow." },
];

const stepColors = ["border-signal-green", "border-wine", "border-signal-red", "border-pine"];

const accountTypes = [
  {
    id: "sahulat",
    name: "Sahulat (Easy) Account",
    steps: [
      { title: "Fill in your basics", text: "Complete our simple sign-up form with your basic information." },
      { title: "Verify with OTP", text: "Enter the one-time password sent to your registered mobile number." },
      { title: "Submit your NIC", text: "Upload your National Identity Card for quick verification to get started." },
      { title: "Receive account info", text: "Check your registered email for account credentials and next steps." },
    ],
    faqs: [
      { q: "What makes the Sahulat Account different?", a: "It's designed for simplicity. Perfect for new investors or those who want essential trading features without complexity. You get everything you need to start building wealth—just streamlined and straightforward." },
      { q: "What's the investment limit?", a: "Your Sahulat Account comes with a reasonable investment limit that's perfect for getting started and building your portfolio gradually. As you grow, you can easily upgrade to our Individual Account for unlimited access." },
      { q: "Do I need extensive documentation?", a: "Nope. Just your NIC and basic details. We've stripped away the paperwork so you can start investing faster." },
      { q: "Can I upgrade later?", a: "Absolutely. Your Sahulat Account is your stepping stone. When you're ready for more advanced features and higher limits, upgrading to an Individual Account is just a few clicks away." },
      { q: "Is this really free?", a: "Yes, it's actually free. No hidden charges, no surprise fees when you sign up. You open it, start investing, and only pay standard trading fees after your first 30 days—exactly as it should be." },
    ],
  },
  {
    id: "individual",
    name: "Individual Account",
    steps: [
      { title: "Fill in your basics", text: "Complete our simple sign-up form with your basic information." },
      { title: "Verify with OTP", text: "Enter the one-time password sent to your registered mobile number." },
      { title: "Submit your details", text: "Upload your ID and documents to complete verification." },
      { title: "Receive account info", text: "Check your registered email for account credentials and next steps." },
    ],
    faqs: [
      { q: "What exactly is a \"free\" account?", a: "It's actually free. No hidden charges, no \"gotcha\" moments when you sign up. You open it, start investing, and only pay when you make trades—just like it should be." },
    ],
  },
  {
    id: "corporate",
    name: "Corporate Account",
    steps: [
      { title: "Tell us about your business", text: "Fill out the form, get a call from a specialist within 30 minutes." },
      { title: "Upload your documents", text: "Get a customized checklist, document gathering support, and template assistance (e.g., board resolution)." },
      { title: "Set up your team", text: "Set custom trading limits and controls with a scheduled call for personalized setup." },
      { title: "Start trading", text: "Personalized team training and hands-on support for your first trades." },
    ],
    faqs: [
      { q: "What makes a corporate account different?", a: "Think of it as your business getting VIP treatment. You get multiple team members trading, higher limits, bulk transaction tools, and detailed reporting. Everything your business needs to invest professionally." },
      { q: "How much money do we need to start?", a: "Whatever makes sense for your business. We've seen companies start with 500K and others with 50 million. The account grows with you, so start where you're comfortable." },
      { q: "Who can access and trade on the account?", a: "You decide. Set up your team with different permission levels—some can view only, others can trade up to certain limits. You stay in control of who does what." },
      { q: "What documents do we actually need?", a: "The usual business stuff: company registration, tax papers, a board resolution saying you can trade stocks, and ID copies of whoever will be trading. Here's the best part: we'll send you a personalized checklist, help you gather everything, and if you're missing something like a board resolution, we'll draft the template for you. Zero stress." },
      { q: "How long does this whole process take?", a: "Usually 2-3 business days once we have your documents. We need the extra time to verify everything properly with PSX and SECP. Your dedicated account manager texts you daily updates and handles any issues before they become problems. No surprises, no waiting around wondering what's happening." },
      { q: "What are the trading costs after the free month?", a: "Simple and transparent: 0.03% or Rs 0.15 per trade (whichever is higher) whether you're day trading or buying to hold. Rollover fees are just Rs 0.01-0.02. We handle all the regulatory stuff (taxes, CDC charges) at actual cost—no markup." },
      { q: "Are there hidden fees we should worry about?", a: "Nope. Just the standard regulatory charges that every broker has to collect—provincial sales tax, capital value tax, and maintenance fees. We pass these through at actual cost and keep you informed about everything." },
      { q: "Can we set spending limits and controls?", a: "Absolutely. Set daily trading limits, require approvals for big transactions, create whatever controls fit your risk management. Your business, your rules." },
      { q: "What if something goes wrong or we need help?", a: "You get a dedicated account manager who knows your business and actually picks up the phone. No phone trees, no ticket systems, no \"please hold.\" Just direct access to someone who can solve problems in real-time. We even give you their WhatsApp number for quick questions. That's how confident we are in our service." },
      { q: "Is our money and data safe?", a: "Your funds stay in your own bank account—we never touch them. We're fully licensed by PSX and regulated by SECP. Your business information gets the same protection as major corporations." },
      { q: "Ready to give your business the investment tools it deserves?", a: "Opening a corporate account is faster than your next team meeting, and we'll literally hold your hand through everything. No corporate bureaucracy, just results." },
    ],
  },
];

const input = "w-full h-[46px] border border-line rounded px-3 text-[15px] text-ink font-sans bg-white";
---
<RevampPage
  title="IEL | Open Account"
  ogTitle="Open Account | Integrated Equities Limited (IEL)"
  description="Smart moves. Sharp insights. Financial freedom—your way. From your first stock pick to your next big acquisition—we're in it with you. IEL brings bespoke brokerage, laser-focused advisory, and strategy consulting under one roof"
  path="OpenAccount.html"
  ogDescription="Open a free brokerage account with IEL in minutes. Choose from Sahulat, Individual, or Corporate accounts with low, transparent trading fees."
>
  <PageHero
    eyebrow="Open an account"
    title="Ready to make your money work smarter?"
    lede="From your first investment to your retirement plan, we've got strategies that fit your life. Open a free brokerage account with IEL in minutes."
  >
    <a href="#account-types" class="border border-ink text-ink hover:bg-white no-underline px-[22px] py-[13px] rounded font-semibold text-[15px]">Compare account types</a>
    <a href={CDC_PORTAL_URL} target="_blank" rel="noopener" class="border border-ink text-ink hover:bg-white no-underline px-[22px] py-[13px] rounded font-semibold text-[15px]">Self registration (Assan Connect)</a>

    <div slot="aside" id="account-form-container" class="bg-white border border-line border-t-4 border-t-signal-red p-6 md:p-8">
      <h2 class="m-0 font-serif font-medium text-[26px] text-pine">Open a free account</h2>
      <p class="mt-2 mb-6 text-[15px] text-muted-body">Leave your name and mobile number and our team will get in touch.</p>
      <form id="account-form" class="flex flex-col gap-4">
        <div class="flex flex-col gap-1.5">
          <label for="name" class="text-sm font-medium text-ink">Name</label>
          <input type="text" id="name" name="name" autocomplete="name" placeholder="Enter name" required class={input} />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="number" class="text-sm font-medium text-ink">Mobile number</label>
          <input type="tel" id="number" name="number" autocomplete="tel" inputmode="tel" placeholder="+92 - 3119899898" required class={input} />
        </div>
        <button type="submit" class="bg-accent hover:bg-accent-dark text-white border-0 px-[22px] py-[13px] rounded font-semibold text-[15px] font-sans cursor-pointer disabled:opacity-60">Submit</button>
        <p id="account-form-status" class="m-0 text-[15px] min-h-[1.5em]" role="status" aria-live="polite"></p>
      </form>
      <div class="mt-2 pt-5 border-t border-line flex flex-col gap-2 text-[15px]">
        <span class="text-muted-body">
          Want to open another account type?
          <a href="#account-types" class="text-accent hover:text-accent-dark underline font-semibold">See account types</a>
        </span>
        <a href={CDC_PORTAL_URL} target="_blank" rel="noopener" class="text-accent hover:text-accent-dark underline font-semibold">Self Registration Assan Connect (CDC portal) →</a>
      </div>
    </div>
  </PageHero>

  <!-- Rates -->
  <section class="max-w-site mx-auto px-6 py-16 md:py-24">
    <SectionHeading
      eyebrow="Pricing"
      title="Start investing without the wait—or any fees."
      intro="Low, transparent trading costs. Taxes and regulatory charges are passed through at actual cost."
    />
    <ul class="list-none m-0 p-0 grid gap-px grid-lines border border-line [grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr))]">
      {rates.map((r, i) => (
        <li class="bg-white p-7 md:p-8 flex flex-col gap-2.5">
          <span class="text-[13px] text-wine font-semibold">{String(i + 1).padStart(2, "0")}</span>
          <span class="font-serif text-[28px] md:text-[32px] text-pine leading-tight">{r.value}</span>
          <span class="text-[15px] font-semibold text-ink">{r.label}</span>
          <p class="m-0 text-[15px] text-muted-body">{r.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Account types: steps + FAQs -->
  <section id="account-types" class="bg-mist border-y border-line">
    <div class="max-w-site mx-auto px-6 py-16 md:py-24">
      <SectionHeading
        eyebrow="How it works"
        title="Open your account in minutes"
        intro="Experience fast, secure, and seamless onboarding."
      />

      <div role="tablist" aria-label="Account types" id="account-tablist" class="hidden flex-wrap gap-px bg-line border border-line mb-12 w-fit max-w-full">
        {accountTypes.map((t, i) => (
          <button
            type="button"
            role="tab"
            id={`${t.id}-tab`}
            data-tab={t.id}
            aria-controls={`${t.id}-content`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            class="tab-button bg-white text-ink aria-selected:bg-accent aria-selected:text-white border-0 px-5 py-3 font-sans font-semibold text-[15px] cursor-pointer grow"
          >{t.name}</button>
        ))}
      </div>

      {accountTypes.map((t) => (
        <div id={`${t.id}-content`} role="tabpanel" aria-labelledby={`${t.id}-tab`} class="team-content mb-16 last:mb-0">
          <h3 class="m-0 mb-8 font-serif font-medium text-[26px] md:text-[30px] text-pine">{t.name}</h3>
          <ol class="list-none m-0 p-0 grid gap-8 [grid-template-columns:repeat(auto-fit,minmax(min(220px,100%),1fr))]">
            {t.steps.map((s, i) => (
              <li class={`border-t-4 ${stepColors[i]} pt-5 flex flex-col gap-2`}>
                <span class="text-[13px] text-wine font-semibold">Step {i + 1}</span>
                <h4 class="m-0 font-serif font-normal text-[22px] text-ink">{s.title}</h4>
                <p class="m-0 text-muted-body text-[15px]">{s.text}</p>
              </li>
            ))}
          </ol>

          <div class="mt-14 grid gap-10 [grid-template-columns:repeat(auto-fit,minmax(min(280px,100%),1fr))] md:[grid-template-columns:1fr_2fr]">
            <div class="flex flex-col gap-4 items-start">
              <span class="text-[13px] font-semibold tracking-[1.5px] uppercase text-wine">FAQs</span>
              <h4 class="m-0 font-serif font-medium text-[24px] leading-[1.25] text-pine">The questions everyone asks (and the straight answers you deserve)</h4>
              <a href="Contact.html" class="border border-ink text-ink hover:bg-white no-underline px-[22px] py-[13px] rounded font-semibold text-[15px]">Contact us</a>
            </div>
            <div class="border-t border-line">
              {t.faqs.map((f) => (
                <details class="group border-b border-line">
                  <summary class="list-none [&::-webkit-details-marker]:hidden cursor-pointer py-5 flex justify-between items-start gap-6 font-semibold text-[16px] text-ink hover:text-accent">
                    <span>{f.q}</span>
                    <span aria-hidden="true" class="text-wine text-xl leading-none transition-transform group-open:rotate-45">+</span>
                  </summary>
                  <p class="m-0 pb-6 pr-8 text-[15px] text-muted-body">{f.a}</p>
                </details>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <script is:inline slot="scripts">
    (function () {
      // Quick sign-up form: same endpoint and payload ({ phone, name }) as before.
      const form = document.getElementById("account-form");
      const statusEl = document.getElementById("account-form-status");
      const formContainer = document.getElementById("account-form-container");
      const button = form.querySelector('button[type="submit"]');

      form.addEventListener("submit", async function (event) {
        event.preventDefault();
        const nameInput = document.getElementById("name");
        const phoneInput = document.getElementById("number");
        // Same rule as before (both fields required), and whitespace-only values are rejected.
        nameInput.value = nameInput.value.trim();
        phoneInput.value = phoneInput.value.trim();
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }
        const phoneNumber = phoneInput.value;
        const UserName = nameInput.value;

        button.disabled = true;
        statusEl.className = "m-0 text-[15px] min-h-[1.5em] text-muted-body";
        statusEl.textContent = "Sending…";
        try {
          const response = await fetch("https://ielapis.u2ventures.io/api/contact/free-account/", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ phone: phoneNumber, name: UserName }),
          });
          if (!response.ok) throw new Error("API request failed");

          formContainer.innerHTML =
            '<div role="status" aria-live="polite" class="flex flex-col gap-2">' +
            '<h2 class="m-0 font-serif font-medium text-[26px] text-pine">Thank you!</h2>' +
            '<p class="m-0 text-[15px] text-muted-body">Your phone number has been successfully submitted. Our team will be in touch.</p>' +
            "</div>";
        } catch (error) {
          console.error("Free account request failed:", error);
          statusEl.className = "m-0 text-[15px] min-h-[1.5em] text-signal-red";
          statusEl.textContent = "Error submitting phone number. Please try again.";
          button.disabled = false;
        }
      });

      // Account type tabs (without JS all three panels stay visible, one after another).
      const tablist = document.getElementById("account-tablist");
      const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
      function selectTab(id) {
        tabs.forEach((tab) => {
          const selected = tab.dataset.tab === id;
          tab.setAttribute("aria-selected", selected ? "true" : "false");
          tab.tabIndex = selected ? 0 : -1;
          document.getElementById(tab.dataset.tab + "-content").hidden = !selected;
        });
      }
      tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => selectTab(tab.dataset.tab));
        tab.addEventListener("keydown", (e) => {
          if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
          e.preventDefault();
          const next = tabs[(i + (e.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length];
          selectTab(next.dataset.tab);
          next.focus();
        });
      });
      tablist.classList.remove("hidden");
      tablist.classList.add("flex");
      selectTab(tabs[0].dataset.tab);
    })();
  </script>
</RevampPage>
