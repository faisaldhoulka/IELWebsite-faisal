---
// Financial statements: five tabs, each grouped by financial year (July to June) with
// search and collapsible year cards. Rows come from the hard-coded list in
// public/supabaseFinancialStatements.js merged with the Supabase table; that script
// renders into the *-content panels below (ids must match its tabMapping).
import RevampPage from "../layouts/RevampPage.astro";
import PageHero from "../components/PageHero.astro";

const tabs = [
  { id: "Economy", label: "Audited Financials 30 June" },
  { id: "Strategy", label: "Half Yearly 31 Dec" },
  { id: "Sector", label: "Quarter Ended 30 Sept" },
  { id: "Market", label: "Quarter Ended 31 March" },
  { id: "lcb", label: "LCB" },
];
---
<RevampPage
  title="IEL | Financial Statements"
  ogTitle="Financial Statements | Integrated Equities Limited (IEL)"
  description="Smart moves. Sharp insights. Financial freedom—your way.
From your first stock pick to your next big acquisition—we're in it with you. IEL brings bespoke brokerage, laser-focused advisory, and strategy consulting under one roof"
  path="NewReport.html"
  ogDescription="Download IEL's audited financial statements, half-yearly and quarterly reports, and monthly liquid capital balance filings."
>
  <PageHero
    eyebrow="Investor relations"
    title="Financial statements"
    lede="Audited annual accounts, half-yearly and quarterly statements, and monthly liquid capital balance (LCB) filings, grouped by financial year (July to June)."
  />

  <section class="max-w-site mx-auto px-6 py-16 md:py-24">
    <h2 class="sr-only">Statements by type</h2>

    <!-- Tabs: bordered segmented control -->
    <div class="overflow-x-auto">
      <div role="tablist" aria-label="Statement type" class="inline-flex min-w-max border border-accent rounded overflow-hidden">
        {tabs.map((t, i) => (
          <button
            type="button"
            role="tab"
            id={`${t.id}-tab`}
            aria-controls={`${t.id}-content`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? "0" : "-1"}
            class:list={[
              "tab-button px-5 py-3 text-sm font-semibold font-sans whitespace-nowrap cursor-pointer border-0 border-l border-solid border-accent first:border-l-0",
              i === 0 ? "bg-accent text-white" : "bg-white text-accent hover:bg-mist",
            ]}
          >{t.label}</button>
        ))}
      </div>
    </div>

    {tabs.map((t, i) => (
      <div
        id={`${t.id}-content`}
        role="tabpanel"
        aria-labelledby={`${t.id}-tab`}
        class:list={["team-content mt-10", i !== 0 && "hidden"]}
      >
        <p class="m-0 border border-line bg-mist p-6 text-[15px] text-muted-body">Loading statements…</p>
      </div>
    ))}
  </section>

  <Fragment slot="scripts">
    <script is:inline>
      // Tabs: show one panel at a time; arrow keys move between tabs.
      (function () {
        const tabs = Array.from(document.querySelectorAll(".tab-button"));
        const ACTIVE = ["bg-accent", "text-white"];
        const IDLE = ["bg-white", "text-accent", "hover:bg-mist"];

        function select(tab, focus) {
          tabs.forEach((t) => {
            const on = t === tab;
            t.classList.remove(...ACTIVE, ...IDLE);
            t.classList.add(...(on ? ACTIVE : IDLE));
            t.setAttribute("aria-selected", on ? "true" : "false");
            t.tabIndex = on ? 0 : -1;
            const panel = document.getElementById(t.getAttribute("aria-controls"));
            if (panel) panel.classList.toggle("hidden", !on);
          });
          if (focus) tab.focus();
        }

        tabs.forEach((tab, i) => {
          tab.addEventListener("click", () => select(tab, false));
          tab.addEventListener("keydown", (e) => {
            let next = null;
            if (e.key === "ArrowRight") next = tabs[(i + 1) % tabs.length];
            else if (e.key === "ArrowLeft") next = tabs[(i - 1 + tabs.length) % tabs.length];
            else if (e.key === "Home") next = tabs[0];
            else if (e.key === "End") next = tabs[tabs.length - 1];
            if (next) {
              e.preventDefault();
              select(next, true);
            }
          });
        });
      })();
    </script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script is:inline src="supabaseFinancialStatements.js?v=7"></script>
  </Fragment>
</RevampPage>
