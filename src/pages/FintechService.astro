---
// Fintech & Digital Solutions service page — revamp design.
import RevampPage from "../layouts/RevampPage.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";

const services = [
  { title: "White-label brokerage apps", text: "Your brand, our technology. Complete mobile and web trading platforms that you can customise and launch under your own identity, without the development headaches." },
  { title: "AI-powered investment insights", text: "Analytics powered by artificial intelligence that spot patterns, identify trends and deliver insights that make sense to everyone." },
  { title: "API-based trading infrastructure", text: "Reliable API infrastructure that links your systems to trading platforms, market data and financial services." },
  { title: "Investor education platforms", text: "Interactive learning tools that turn complex financial concepts into clear, actionable knowledge." },
];

const clients = [
  { src: "IEL Assets/partners/logo_1.png", alt: "Agritech" },
  { src: "IEL Assets/partners/logo_2.png", alt: "ABL Funds" },
  { src: "IEL Assets/partners/logo_3.png", alt: "NBP Funds" },
  { src: "IEL Assets/partners/logo_4.png", alt: "Pakistan Cricket Board" },
  { src: "IEL Assets/partners/logo_5.png", alt: "Masood Textile Mills" },
];

const faqs = [
  { q: "What makes your trading platform special?", a: "It makes sense. Clean design, real insights and no fluff. We built it for people who want to trade smart, not just trade often." },
  { q: "Can I use your technology for my own business?", a: "Yes. Our white-label solutions let you launch trading platforms under your own brand, with proven technology and without the development headaches." },
  { q: "How does your AI investment tool work?", a: "It spots patterns and trends that are easy to miss, then explains them in plain English. Instead of overwhelming you with data, it gives you actionable insights that help you invest smarter." },
];

const stepColors = ["border-signal-green", "border-wine", "border-signal-red", "border-pine"];
const accounts = [
  {
    name: "Sahulat (Easy) Account",
    steps: [
      { title: "Fill in your basics", text: "Complete our simple sign-up form with your basic information." },
      { title: "Verify with OTP", text: "Enter the one-time password sent to your registered mobile number." },
      { title: "Submit your NIC", text: "Upload your National Identity Card for quick verification to get started." },
      { title: "Receive account info", text: "Check your registered email for account credentials and next steps." },
    ],
  },
  {
    name: "Individual Account",
    steps: [
      { title: "Fill in your basics", text: "Complete our simple sign-up form with your basic information." },
      { title: "Verify with OTP", text: "Enter the one-time password sent to your registered mobile number." },
      { title: "Submit your details", text: "Upload your ID and documents to complete verification." },
      { title: "Receive account info", text: "Check your registered email for account credentials and next steps." },
    ],
  },
  {
    name: "Corporate Account",
    steps: [
      { title: "Tell us about your business", text: "Fill out the form and get a call from a specialist within 30 minutes." },
      { title: "Upload your documents", text: "Get a customised checklist, document gathering support and template assistance (e.g. board resolution)." },
      { title: "Set up your team", text: "Set custom trading limits and controls, with a scheduled call for personalised setup." },
      { title: "Start trading", text: "Personalised team training and hands-on support for your first trades." },
    ],
  },
];

const btnPrimary = "bg-accent hover:bg-accent-dark text-white no-underline px-[22px] py-[13px] rounded font-semibold text-[15px]";
const btnSecondary = "border border-ink text-ink hover:bg-white no-underline px-[22px] py-[13px] rounded font-semibold text-[15px]";
---
<RevampPage
  title="IEL | Fintech & Digital Solutions"
  ogTitle="Fintech & Digital Solutions | Integrated Equities Limited (IEL)"
  description="Expert Fintech & Digital Solutions services to help you navigate the complexities of the financial markets and achieve your goals."
  path="FintechService.html"
>
  <PageHero
    eyebrow="Fintech"
    title="Fintech and digital solutions"
    lede="Fintech that works: making finance intuitive for your clients and scalable for you."
  >
    <a href="index.html#contact" class={btnPrimary}>Discuss a mandate</a>
    <a href="Contact.html" class={btnSecondary}>Book a free consultation</a>
    <div slot="aside" class="bg-white border border-line border-t-4 border-t-signal-green p-7 md:p-9 flex flex-col gap-3.5">
      <h2 class="m-0 font-serif font-medium text-[24px] md:text-[28px] leading-[1.2] text-pine">Trading doesn't have to be complicated.</h2>
      <p class="m-0 text-muted-body text-[15px]">We built a platform that makes sense: clean charts, real insights and no fluff, because your money deserves better than guesswork.</p>
      <a href="OpenAccount.html" class="self-start font-semibold text-[15px] text-accent hover:text-accent-dark underline">Start trading →</a>
    </div>
  </PageHero>

  <!-- Services -->
  <section class="max-w-site mx-auto px-6 py-16 md:py-24">
    <SectionHeading eyebrow="What we do" title="Fintech and digital services" />
    <div class="grid gap-px grid-lines border border-line [grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr))]">
      {services.map((s, i) => (
        <article class="bg-white p-7 md:p-9 flex flex-col gap-3.5">
          <span class="text-[13px] text-wine font-semibold">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="m-0 font-serif font-medium text-2xl text-ink">{s.title}</h3>
          <p class="m-0 text-muted-body text-[15px]">{s.text}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Clients -->
  <section class="bg-pine text-white">
    <div class="max-w-site mx-auto px-6 py-16 md:py-24">
      <SectionHeading eyebrow="Clients" title="Who we have worked with" dark />
      <ul class="list-none m-0 p-0 grid gap-5 [grid-template-columns:repeat(auto-fit,minmax(min(180px,100%),1fr))]">
        {clients.map((c) => (
          <li class="h-[120px] bg-white border border-pine-line flex items-center justify-center p-4">
            <img src={c.src} alt={c.alt} class="max-h-full max-w-full w-auto object-contain" loading="lazy" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQs -->
  <section class="max-w-site mx-auto px-6 py-16 md:py-24 grid gap-10 md:grid-cols-[1fr_2fr]">
    <div class="flex flex-col gap-3">
      <span class="text-[13px] font-semibold tracking-[1.5px] uppercase text-wine">FAQs</span>
      <h2 class="m-0 font-serif font-medium text-[30px] md:text-[40px] leading-[1.15] text-pine">Questions we are often asked</h2>
      <p class="m-0 text-muted-body">Something else on your mind? <a href="Contact.html" class="text-accent hover:text-accent-dark underline font-semibold">Contact us</a>.</p>
    </div>
    <div class="border-t border-line">
      {faqs.map((f) => (
        <details class="group border-b border-line">
          <summary class="cursor-pointer list-none flex justify-between items-start gap-4 py-5 font-serif text-[19px] text-ink [&::-webkit-details-marker]:hidden">
            {f.q}
            <span class="text-wine font-sans text-xl leading-none group-open:rotate-45 transition-transform" aria-hidden="true">+</span>
          </summary>
          <p class="m-0 pb-5 text-muted-body text-[15px] max-w-[680px]">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- Account opening -->
  <section class="bg-mist border-t border-line">
    <div class="max-w-site mx-auto px-6 py-16 md:py-24">
      <SectionHeading eyebrow="Brokerage" title="Open your account in minutes" intro="Fast, secure and simple onboarding for individual and corporate investors." />
      <div class="border-t border-line-strong">
        {accounts.map((acc, i) => (
          <details class="group border-b border-line-strong" open={i === 0}>
            <summary class="cursor-pointer list-none flex justify-between items-center gap-4 py-5 font-serif text-[22px] text-pine [&::-webkit-details-marker]:hidden">
              {acc.name}
              <span class="text-wine font-sans text-xl leading-none group-open:rotate-45 transition-transform" aria-hidden="true">+</span>
            </summary>
            <ol class="list-none m-0 p-0 pb-8 grid gap-8 [grid-template-columns:repeat(auto-fit,minmax(min(220px,100%),1fr))]">
              {acc.steps.map((st, j) => (
                <li class={`border-t-4 ${stepColors[j]} pt-5 flex flex-col gap-2`}>
                  <span class="text-[13px] text-wine font-semibold">Step {j + 1}</span>
                  <h3 class="m-0 font-serif font-normal text-[20px]">{st.title}</h3>
                  <p class="m-0 text-muted-body text-[15px]">{st.text}</p>
                </li>
              ))}
            </ol>
          </details>
        ))}
      </div>
      <div class="mt-10">
        <a href="OpenAccount.html" class={btnPrimary}>Get started</a>
      </div>
    </div>
  </section>
</RevampPage>
