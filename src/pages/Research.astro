---
// Research library: reports load from Supabase in the browser (public/supabaseReseach.js),
// filtered by sector tab, report type and search.
import RevampPage from "../layouts/RevampPage.astro";
import PageHero from "../components/PageHero.astro";

const freqs = ["All", "Daily", "Weekly", "Market-wide"];
---
<RevampPage
  title="IEL | Research"
  ogTitle="Research | Integrated Equities Limited (IEL)"
  description="Smart moves. Sharp insights. Financial freedom—your way.
From your first stock pick to your next big acquisition—we're in it with you. IEL brings bespoke brokerage, laser-focused advisory, and strategy consulting under one roof"
  path="Research.html"
  ogDescription="Access IEL's research reports covering sector analysis, market insights, and investment intelligence for Pakistan's capital markets."
>
  <PageHero
    eyebrow="Research"
    title="Research"
    lede="Economic, market, sector and company research on Pakistan's capital markets, from the team that informs our advice."
  >
    <form id="searchForm" role="search" class="w-full max-w-[560px] flex flex-col gap-1.5">
      <label for="searchInput" class="text-sm font-medium text-ink">Search reports</label>
      <div class="flex flex-wrap gap-3">
        <input
          id="searchInput"
          type="search"
          placeholder="Try “fertilizer” or “FFC”"
          class="h-[46px] min-w-0 flex-1 basis-[220px] border border-line rounded px-3 text-[15px] text-ink font-sans bg-white focus:outline-none focus:border-accent"
        />
        <button
          type="submit"
          class="h-[46px] bg-accent hover:bg-accent-dark text-white px-[22px] rounded font-semibold text-[15px] font-sans cursor-pointer"
        >Search</button>
      </div>
    </form>
  </PageHero>

  <section class="max-w-site mx-auto px-6 py-16 md:py-24" aria-labelledby="reports-heading">
    <div class="flex flex-col gap-3 mb-8">
      <span class="text-[13px] font-semibold tracking-[1.5px] uppercase text-wine">Library</span>
      <h2 id="reports-heading" class="m-0 font-serif font-medium text-[30px] md:text-[40px] leading-[1.15] text-pine">Research reports</h2>
    </div>

    <!-- Sector tabs (built from the sector table by the script) -->
    <div class="border-b border-line overflow-x-auto">
      <div id="categoryTabs" class="flex gap-7 min-w-max" aria-label="Sector">
        <span class="pb-3 text-[15px] text-muted">Loading sectors…</span>
      </div>
    </div>

    <!-- Report type filter -->
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <span id="freqLabel" class="text-sm font-medium text-muted-body">Report type</span>
      <div id="freqPills" role="group" aria-labelledby="freqLabel" class="inline-flex flex-wrap border border-accent rounded overflow-hidden">
        {freqs.map((f) => (
          <button type="button" data-freq={f} aria-pressed={f === "All" ? "true" : "false"} class="pill-btn">{f}</button>
        ))}
      </div>
    </div>

    <!-- List + latest -->
    <div class="mt-8 grid grid-cols-1 lg:grid-cols-[1fr_300px] gap-8 items-start">
      <div id="researchContainer" class="flex flex-col gap-4 min-w-0" aria-live="polite">
        <p class="m-0 border border-line bg-mist p-6 text-[15px] text-muted-body">Loading reports…</p>
      </div>

      <aside class="border border-line p-6" aria-labelledby="trending-heading">
        <h3 id="trending-heading" class="m-0 text-[13px] font-semibold tracking-[1.5px] uppercase text-wine">Latest in this sector</h3>
        <ol id="trendingList" class="list-none m-0 mt-3 p-0"></ol>
      </aside>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script is:inline src="supabaseReseach.js?v=2"></script>
  </Fragment>
</RevampPage>
