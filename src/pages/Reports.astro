---
// Reports — revamp design. Corporate reports available as PDF downloads.
import RevampPage from "../layouts/RevampPage.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";

const reports = [
  { name: "SLGL Corporate Report", href: "IEL Assets/PDF/SLGL Corporate Report .pdf" },
];
---
<RevampPage
  title="IEL | Corporate Reports"
  description="Smart moves. Sharp insights. Financial freedom—your way. From your first stock pick to your next big acquisition—we're in it with you. IEL brings bespoke brokerage, laser-focused advisory, and strategy consulting under one roof"
  path="Reports.html"
>
  <PageHero
    eyebrow="Research"
    title="Corporate Reports"
    lede="We dig deep so you don't have to. Clear, actionable insights that help you make confident investment moves."
  >
    <a href="Research.html" class="border border-ink text-ink hover:bg-white no-underline px-[22px] py-[13px] rounded font-semibold text-[15px]">All research</a>
  </PageHero>

  <section class="max-w-site mx-auto px-6 py-16 md:py-24">
    <SectionHeading eyebrow="Downloads" title="Corporate Reports" />
    <ul class="list-none m-0 p-0 grid gap-6 [grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr))]">
      {reports.map((r) => (
        <li class="border border-line hover:border-line-dash hover:bg-mist">
          <a href={r.href} target="_blank" rel="noopener" class="no-underline text-ink p-7 flex flex-col gap-2.5 h-full">
            <span class="text-[13px] text-wine font-semibold">Corporate report · PDF</span>
            <h3 class="m-0 font-serif font-normal text-[22px] leading-[1.3]">{r.name}</h3>
            <span class="mt-2 text-sm font-semibold text-accent underline">Download PDF</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</RevampPage>
